// =====================================================================
// MANUFACTURING (Phase 27, hnerve-gap-map.md "Manufacturing" row).
// BillOfMaterials describes how one output Product is assembled from
// component Products; ManufacturingOrder is one production run of a
// BOM. Completing an order writes MFG_CONSUME / MFG_PRODUCE rows into
// the existing InventoryMovement ledger (stock truth) and — when the
// BOM carries labor/overhead cost — one JournalEntry into the existing
// double-entry engine. String-union statuses per the CLAUDE.md SQLite
// rule; tenantId is the same opaque label as Product/InventoryMovement.
// =====================================================================

model BillOfMaterials {
  id           String    @id @default(cuid())
  tenantId     String
  bomNumber    String // BOM-000001 via NumberingScheme
  name         String
  // The output product this BOM assembles.
  productId    String
  // How many units of the output one run of the BOM yields.
  outputQty    Int       @default(1)
  // Extra per-run costs beyond materials. Money (12,2).
  laborCost    Decimal   @default(0)
  overheadCost Decimal   @default(0)
  active       Boolean   @default(true)
  note         String?

  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  product      Product              @relation("BomOutput", fields: [productId], references: [id])
  lines        BomLine[]
  operations   BomOperation[]
  byproducts   BomByproduct[]
  orders       ManufacturingOrder[]

  @@unique([tenantId, bomNumber])
  @@index([tenantId, deletedAt])
  @@index([tenantId, productId])
}

model BomLine {
  id                 String @id @default(cuid())
  bomId              String
  componentProductId String
  // Component units consumed per ONE run of the BOM (not per output unit).
  quantity           Int

  bom                BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  component          Product         @relation("BomComponent", fields: [componentProductId], references: [id])

  @@index([bomId])
  @@index([componentProductId])
}

// =====================================================================
// MANUFACTURING v2 — production routings (Odoo mrp model, translated).
// WorkCenter = a station/machine/line with an hourly rate; BomOperation
// = one ordered routing stage on a BOM, executed at a work center for
// an expected duration; WorkOrder = the per-stage execution record
// generated from the BOM's operations when an order starts. Routing
// labor (Σ actual-or-planned minutes × the rate frozen at start) is
// ADDED to the BOM's flat per-run laborCost in the cost rollup — BOMs
// without operations behave exactly as v1. BomByproduct = secondary
// outputs (incl. expected scrap) that take a % share of total cost.
// =====================================================================

model WorkCenter {
  id          String    @id @default(cuid())
  tenantId    String
  code        String // WC-000001 via NumberingScheme
  name        String
  nameEn      String?
  // Cost of one hour of this work center's time. Money (12,2).
  costPerHour Decimal   @default(0)
  // Time efficiency %, Odoo-style: real duration = expected / (efficiency/100).
  efficiency  Int       @default(100)
  // Flat minutes added once per work order, before/after the operation
  // itself (Odoo time_start / time_stop).
  setupMinutes   Decimal @default(0)
  cleanupMinutes Decimal @default(0)
  active      Boolean   @default(true)
  note        String?

  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  operations  BomOperation[]
  workOrders  WorkOrder[]
  maintenanceOrders MaintenanceOrder[]
  // Odoo alternative_workcenter_ids — fallback centers the planner can
  // reassign a PENDING work order to when this one is unavailable.
  // Symmetric in practice: the app always writes both connect directions
  // on save, so callers only ever need to read `alternatives`.
  alternatives  WorkCenter[] @relation("WorkCenterAlternatives")
  alternativeOf WorkCenter[] @relation("WorkCenterAlternatives")

  @@unique([tenantId, code])
  @@index([tenantId, deletedAt])
}

model BomOperation {
  id              String @id @default(cuid())
  bomId           String
  workCenterId    String
  // Execution order within the routing (10, 20, 30…). Still used as the
  // default/display order; actual start-gating now runs on blockedByOps
  // below, not on this number.
  sequence        Int    @default(10)
  name            String
  // Expected minutes for ONE run of the BOM at 100% efficiency. Ignored
  // when durationMode is "auto" (used only as the pre-history fallback).
  durationMinutes Decimal @default(60)
  // manual = durationMinutes as authored; auto = averaged from the last
  // N DONE work orders' actual (or planned) minutes for this operation —
  // Odoo time_mode "based on last N work orders".
  durationMode    String  @default("manual")

  bom             BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  workCenter      WorkCenter      @relation(fields: [workCenterId], references: [id])
  workOrders      WorkOrder[]
  // Odoo "Operation Dependencies" — an arbitrary DAG, not just numeric
  // sequence order. blockedByOps must reach DONE/CANCELLED before a
  // generated work order for this stage may start; blockingOps is the
  // reverse view (which stages this one gates).
  blockedByOps    BomOperation[] @relation("OperationBlocks")
  blockingOps     BomOperation[] @relation("OperationBlocks")

  @@index([bomId])
  @@index([workCenterId])
}

model BomByproduct {
  id               String  @id @default(cuid())
  bomId            String
  productId        String
  // Byproduct units yielded per ONE run of the BOM.
  quantity         Int
  // % of the order's total cost carried by this byproduct (0–100).
  // The main output carries the remainder. Odoo mrp.bom.byproduct
  // cost_share, same semantics.
  costSharePercent Decimal @default(0)
  // Expected waste (scrap) vs a genuinely sellable secondary output.
  isScrap          Boolean @default(false)

  bom              BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  product          Product         @relation("BomByproductOut", fields: [productId], references: [id])

  @@index([bomId])
  @@index([productId])
}

model WorkOrder {
  id           String    @id @default(cuid())
  tenantId     String
  orderId      String
  // Source routing stage; SetNull so deleting a BOM operation never
  // orphans history — the snapshot fields below stay authoritative.
  operationId  String?
  workCenterId String
  sequence     Int
  name         String
  // PENDING | IN_PROGRESS | DONE | CANCELLED
  status       String    @default("PENDING")
  // Expected minutes for the WHOLE order (duration × runs, efficiency-
  // adjusted), frozen at generation time.
  plannedMinutes Decimal
  // Operator-reported minutes, set at completion; null = use planned.
  actualMinutes  Decimal?
  // Work-center hourly rate frozen when the order started, so later
  // rate edits never rewrite history. Money (12,2).
  costPerHour  Decimal
  // (actual ?? planned) / 60 × costPerHour, frozen at completion.
  laborCost    Decimal?
  startedAt    DateTime?
  finishedAt   DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  order        ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  operation    BomOperation?      @relation(fields: [operationId], references: [id], onDelete: SetNull)
  workCenter   WorkCenter         @relation(fields: [workCenterId], references: [id])

  // One generated work order per (order, routing stage): makes the
  // startOrder createMany idempotent under double-submit — the second
  // racer P2002s instead of duplicating stages. NULL operationIds
  // (ad-hoc stages) are exempt (SQLite treats NULLs as distinct).
  @@unique([orderId, operationId])
  @@index([tenantId, status])
  @@index([orderId])
  @@index([workCenterId])
  // Feeds resolveBaseDuration's "auto" mode: last-N-DONE-per-operation,
  // most-recent-first.
  @@index([operationId, status, finishedAt])
}

model ManufacturingOrder {
  id             String    @id @default(cuid())
  tenantId       String
  orderNumber    String // MO-000001 via NumberingScheme
  bomId          String
  // How many runs of the BOM this order executes (output = runs * outputQty).
  runs           Int       @default(1)
  // DRAFT | IN_PROGRESS | DONE | CANCELLED
  status         String    @default("DRAFT")
  // Cost rollup, frozen at completion. Money (12,2).
  materialCost   Decimal?
  laborCost      Decimal?
  overheadCost   Decimal?
  totalCost      Decimal?
  // totalCost / output units — becomes the MFG_PRODUCE movement's unitCost.
  unitCost       Decimal?
  // The labor/overhead accrual entry, when one was posted.
  journalEntryId String?   @unique
  note           String?
  startedAt      DateTime?
  completedAt    DateTime?

  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  bom            BillOfMaterials @relation(fields: [bomId], references: [id])
  journalEntry   JournalEntry?   @relation(fields: [journalEntryId], references: [id])
  workOrders     WorkOrder[]
  scraps         ProductionScrap[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
}

// =====================================================================
// PRODUCTION SCRAP (Odoo stock.scrap, manufacturing-triggered). Distinct
// from BomByproduct.isScrap: byproducts model EXPECTED waste baked into
// the BOM's own cost rollup; ProductionScrap is UNPLANNED floor loss —
// a component wasted before completion, or a finished unit rejected
// after. Posts one SCRAP InventoryMovement (negative delta, no cost
// re-attribution — the unit's cost was already counted upstream) and is
// never reversed; a miscount is corrected with a compensating entry,
// same append-only discipline as InventoryMovement itself.
// =====================================================================
model ProductionScrap {
  id         String   @id @default(cuid())
  tenantId   String
  orderId    String
  productId  String
  quantity   Int
  reason     String?
  userId     String?
  scrappedAt DateTime @default(now())

  order      ManufacturingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product            @relation("ProductionScrapProduct", fields: [productId], references: [id])

  @@index([tenantId, orderId])
  @@index([productId])
}

// =====================================================================
// MAINTENANCE — docs/HOURANI-ERP-GAPS.md #5 🟠. FixedAsset already
// exists (Phase 27) and WorkCenter already has an `active` toggle
// (routing depth, PR #316-318) that the reassignment path already
// respects (`actions.ts` gates alternative-work-center picks on
// `active: true`) — this just gives that toggle a REASON: starting a
// maintenance order takes the work centre offline automatically instead
// of an operator remembering to flip it by hand.
//
// Exactly one of assetId/workCenterId is set — validated in the action
// layer, not the schema (SQLite has no CHECK constraint through Prisma).
// =====================================================================
model MaintenanceOrder {
  id           String    @id @default(cuid())
  tenantId     String
  // CORRECTIVE (something broke) | PREVENTIVE (scheduled)
  type         String    @default("CORRECTIVE")
  // SCHEDULED | IN_PROGRESS | DONE | CANCELLED
  status       String    @default("SCHEDULED")
  description  String
  assetId      String?
  workCenterId String?
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  // Money, precision/scale (12,2) — same precedent as FixedAsset.purchaseCost.
  cost         Decimal?
  note         String?

  asset        FixedAsset? @relation(fields: [assetId], references: [id])
  workCenter   WorkCenter? @relation(fields: [workCenterId], references: [id])

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, assetId])
  @@index([tenantId, workCenterId])
}

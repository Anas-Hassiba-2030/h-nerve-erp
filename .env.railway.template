# ─────────────────────────────────────────────────────────────────────────
# H-Nerve ERP — Railway environment template
#
# Copy these into the Railway service → Variables tab. Secrets are BLANK on
# purpose — fill them in Railway, never commit real values. Generate strong
# secrets with:  openssl rand -hex 32
#
# Legend:  [required] won't boot / core breaks without it
#          [recommended] a feature degrades or disables without it
#          [optional] tuning / provider selection; safe to omit
# ─────────────────────────────────────────────────────────────────────────

# ── Core ───────────────────────────────────────────────────────────────────
# [required] Postgres connection. Railway INJECTS this automatically when a
# PostgreSQL service is linked — do not set it by hand unless self-hosting.
DATABASE_URL=

# [required] iron-session cookie encryption key (>= 32 chars).
SESSION_PASSWORD=

# [recommended] Public base URL of the deployment, no trailing slash. Used for
# absolute links and by the brain-cron GitHub Action's APP_URL secret.
# (RAILWAY_PUBLIC_DOMAIN is injected by Railway and used as a fallback.)
NEXT_PUBLIC_APP_URL=

# ── Auth / seeding ───────────────────────────────────────────────────────────
# [recommended] Password set on the seeded admin account (admin@hourani.jo).
# Overrides the default "admin123"; if you set it, log in with THIS value.
SEED_ADMIN_PASSWORD=

# [optional] Comma-separated emails granted owner privileges on boot.
OWNER_EMAILS=

# [optional] When "true", scripts/seed/ensure-admins.ts resets admin passwords
# on every deploy. Leave unset in steady state.
ENSURE_ADMINS_RESET_PASSWORD=

# ── Brain / AI (Anthropic) ───────────────────────────────────────────────────
# [recommended] Enables the brain's LIVE mode (council, narrator, planner).
# If unset, the brain runs in zero-cost STUB mode — UI still works.
ANTHROPIC_API_KEY=
# [optional] Override the default Claude model id.
ANTHROPIC_MODEL=
# [optional] Hard cap on LLM calls per analysis run (cost guard).
BRAIN_MAX_LLM_CALLS=

# ── Scheduled brain refresh ──────────────────────────────────────────────────
# [recommended] Bearer secret guarding GET /api/brain/cron. Must MATCH the
# CRON_SECRET repository secret used by .github/workflows/brain-cron.yml.
# Without it the cron endpoint fail-closes (503). See docs/RUNBOOK.md § 5.
CRON_SECRET=

# ── External ingestion ───────────────────────────────────────────────────────
# [recommended] Bearer token for POST /api/import/test (n8n / external feeds).
# Without it the endpoint returns 503.
IMPORT_API_TOKEN=

# ── RAG embeddings (provider-select; optional) ───────────────────────────────
# The RAG layer auto-selects a provider from whichever key is present. Set ONE
# provider's key + model. All optional — RAG degrades gracefully if absent.
EMBEDDING_API_KEY=
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=
GEMINI_EMBED_DIM=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=
LLM_API_KEY=

# ── Document Intelligence (Phase 18; optional) ───────────────────────────────
# [optional] Set "true" to enable the Claude Vision document parser.
DOCINTEL_USE_VISION=
# [optional] Cap on Vision calls per document (cost guard).
DOCINTEL_MAX_VISION_CALLS=

# ── Misc / diagnostics (optional) ────────────────────────────────────────────
# [optional] Prisma query logging: "query", "info", "warn", "error".
PRISMA_LOG=
# [optional] Hide the intro animation on first load.
NEXT_PUBLIC_DISABLE_INTRO=
# NODE_ENV is set to "production" by Railway automatically — do not override.

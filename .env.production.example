# H-Nerve — PRODUCTION environment template.
# Supports Railway (recommended) and Vercel + Neon.
# This file has NO real secrets and is safe to commit.

# --- Database ---
# RAILWAY: DATABASE_URL is auto-injected when you add the Postgres plugin.
#          DIRECT_URL is NOT needed — Railway uses a direct connection.
#          Leave DIRECT_URL unset; railway.toml defaults it to DATABASE_URL.
# NEON:    Two URLs from the Neon dashboard:
#          DATABASE_URL = pooled (pgBouncer) for the app runtime.
#          DIRECT_URL   = direct (no pooler) for prisma migrate only.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/railway"
# DIRECT_URL="postgresql://..."  # Neon only — leave unset on Railway

# --- Auth (iron-session — NOT NextAuth) ---
# iron-session cookie secret. MUST be >=32 chars or the app HARD-FAILS
# to boot in production (lib/session.ts). Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_PASSWORD="REPLACE-with-a-fresh-48-byte-random-secret"

# --- App URL ---
# Public origin. Used for the post-logout redirect (app/(auth)/logout).
# Vercel default subdomain is fine for now (no custom domain this phase).
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# --- Import API ---
# Bearer token for POST /api/import/test (the n8n ingestion endpoint).
# Unset -> the endpoint returns 503. Use a REAL secret in production
# (rotate the dev token if reusing). Generate:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
IMPORT_API_TOKEN="REPLACE-with-a-fresh-random-hex-token"

# --- AI (the Brain) ---
# From console.anthropic.com. Without it the Brain runs canned stub mode
# (zero API spend). With it, Council/Narrator moments cost a few cents.
ANTHROPIC_API_KEY="sk-ant-..."
# Optional model + per-process call cap.
# ANTHROPIC_MODEL="claude-sonnet-4-5"
# BRAIN_MAX_LLM_CALLS="200"

# --- Seed (one-time production seed) ---
# Strong admin password for scripts/seed-production.ts. REQUIRED in
# production — do NOT fall back to the dev "admin123".
SEED_ADMIN_PASSWORD="REPLACE-with-a-strong-admin-password"

# --- Document Intelligence (Phase 18) — optional ---
# Stub is the default (zero API spend). "true" extracts real docs with
# Claude Vision and BURNS API credit. Leave unset in production.
# DOCINTEL_USE_VISION="false"
# DOCINTEL_MAX_VISION_CALLS="50"

# --- Demo ---
# Empty in production so real first-time users get the onboarding tour.
NEXT_PUBLIC_DISABLE_INTRO=""

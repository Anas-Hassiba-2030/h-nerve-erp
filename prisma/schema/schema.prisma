generator client {
  // Rust-free / WASM-free client (Prisma 6.19). engineType="client" swaps the
  // library query ENGINE (whose WASM loader uses eval — the exact thing
  // Cloudflare workerd blocks: "Code generation from strings disallowed") for
  // the pure query COMPILER. Requires a driver adapter in every environment and
  // a mandatory custom `output`. moduleFormat=cjs keeps the client CommonJS so
  // it stays a drop-in behind the tsconfig `@prisma/client` alias (no import
  // sites move). See src/lib/db/db.ts for the adapter wiring.
  provider     = "prisma-client"
  engineType   = "client"
  runtime      = "nodejs"
  moduleFormat = "cjs"
  output       = "../../src/generated/prisma"
}

datasource db {
  // PRODUCTION: Railway injects DATABASE_URL automatically.
  // POOLING (the 100-user unlock — see docs/DEPLOYMENT.md § Connection pooling):
  // once the PgBouncer sidecar exists, point DATABASE_URL at the pooler with
  // `?pgbouncer=true&connection_limit=10`, set DIRECT_DATABASE_URL to the raw
  // Postgres URL, and uncomment directUrl below so migrations bypass the pooler.
  // It stays commented until then — Prisma fails on a referenced-but-unset env
  // var at migrate time, which would break the Railway preDeploy.
  // LOCAL DEV: provider="sqlite", DATABASE_URL="file:./dev.db".
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl = env("DIRECT_DATABASE_URL")
}

// =====================================================================
// FINANCE
// =====================================================================

model Transaction {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reference   String   @unique
  kind        String
  category    String
  amount      Float
  currency    String   @default("JOD")
  description String?
  occurredAt  DateTime
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Phase 11 — finance lists filter by company and sort by occurredAt.
  @@index([companyId, occurredAt])
  @@index([createdById])
}

// =====================================================================
// ACCOUNTING (Phase 8) — double-entry. Posted JournalEntries are
// immutable (decision #2); SUM(debits)=SUM(credits) enforced in code
// before POSTED. tenantId opaque (no Tenant FK — family precedent).
// Money = Decimal(12,2), applied at the Phase 11 Postgres cutover.
// =====================================================================
model LedgerAccount {
  id          String   @id @default(cuid())
  tenantId    String
  code        String // "1001", "2001"
  name        String
  type        String // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE | COGS
  description String?
  active      Boolean  @default(true)
  // Phase 9 decision #5: optional warehouse scope for a future
  // sub-ledger. Transfers post NO journal entries (total inventory
  // value is unchanged) — this column is forward-provisioning only.
  warehouseId String?

  lines       JournalLine[]
  // Reverse of Treasury.ledgerAccountId (unique FK) — set when this
  // account is a treasury's cash/bank account, null for ordinary accounts.
  treasury    Treasury?

  createdAt   DateTime @default(now())

  @@unique([tenantId, code])
  @@index([tenantId, type])
}

model FinancialPeriod {
  id        String   @id @default(cuid())
  tenantId  String
  year      Int
  month     Int // 1-12
  status    String   @default("OPEN") // OPEN | CLOSED

  entries   JournalEntry[]

  createdAt DateTime @default(now())

  @@unique([tenantId, year, month])
  @@index([tenantId, status])
  @@index([tenantId, year])
}

model JournalEntry {
  id          String   @id @default(cuid())
  tenantId    String
  periodId    String
  description String
  reference   String? // PO/SO number, etc.
  status      String   @default("POSTED") // DRAFT | POSTED
  reversesId  String?

  period      FinancialPeriod @relation(fields: [periodId], references: [id])
  lines       JournalLine[]
  reverses    JournalEntry?   @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy  JournalEntry[]  @relation("Reversal")
  invoice     Invoice?
  payment     Payment?
  purchaseInvoice PurchaseInvoice?
  supplierPayment SupplierPayment?
  fixedAsset  FixedAsset?
  depreciationEntry DepreciationEntry?
  payrollRun  PayrollRun?
  manufacturingOrder ManufacturingOrder?
  posSale            PosSale?

  postedAt    DateTime?
  createdAt   DateTime @default(now())

  @@index([tenantId, periodId])
  @@index([tenantId, reference])
  @@index([tenantId, status])
}

model JournalLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Decimal  @default(0)
  credit         Decimal  @default(0)
  memo           String?
  // Analytic dimension (docs/HOURANI-ERP-GAPS.md #2 🔴 — "what did the
  // Amman hotel cost me, separately from the dairy plant"). Optional:
  // automated postings (invoicing, POS, payroll, ...) don't tag it yet —
  // v1 wiring is manual journal entries at /admin/journal, which lets an
  // accountant assign a cost centre per line. A dimension-filtered P&L
  // (lib/finance/statements.ts incomeStatement, called with rows already
  // filtered to one costCenterId) reads it back out.
  costCenterId   String?

  entry          JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account        LedgerAccount @relation(fields: [accountId], references: [id])
  costCenter     CostCenter?   @relation(fields: [costCenterId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@index([costCenterId])
}

// =====================================================================
// COST CENTRE — analytic dimension (docs/HOURANI-ERP-GAPS.md #2 🔴). One
// row per business unit the group wants to see separately in a P&L
// (e.g. "Amman Hotel", "Dairy Plant"). Deliberately NOT tied to Company —
// a tenant workspace can have several cost centres (a hotel workspace
// might split front-of-house vs F&B) and the mapping is the owner's
// call, not a 1:1 schema assumption.
// =====================================================================
model CostCenter {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  active    Boolean  @default(true)

  lines     JournalLine[]

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

// =====================================================================
// PURCHASE ORDERS — procurement (Phase 6). DRAFT → SENT → PARTIAL →
// RECEIVED → CANCELLED. Only RECEIVED/PARTIAL receipts write RECEIVED
// inventory movements (via lib/inventory.ts). supplier is an OPAQUE
// string (becomes an FK in Phase 7, same precedent as Product.tenantId).
// deletedAt column only — not registered in lib/softDelete.ts (no trash
// UI), consistent with Product / InventoryMovement.
// =====================================================================
model PurchaseOrder {
  id          String   @id @default(cuid())
  tenantId    String
  poNumber    String   @unique
  supplierId  String
  // DRAFT | SENT | PARTIAL | RECEIVED | CANCELLED
  status      String   @default("DRAFT")
  orderedAt   DateTime @default(now())
  expectedAt  DateTime?
  note        String?

  // Phase NS-1 — back-link to the SupplyForecast that drafted this PO
  // (null for manually-created POs). Authoritative side of the 1:1
  // bridge relation. A bridge PO is intentionally line-less: product /
  // quantity / unit / delivery read through sourceForecast.
  sourceForecastId String?         @unique
  sourceForecast   SupplyForecast? @relation("ForecastSourcedPO", fields: [sourceForecastId], references: [id], onDelete: SetNull)

  lines       PurchaseOrderLine[]
  supplierRef Supplier  @relation(fields: [supplierId], references: [id])

  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, supplierId])
  @@index([tenantId, orderedAt])
}

model PurchaseOrderLine {
  id          String   @id @default(cuid())
  poId        String
  productId   String
  quantity    Int      // ordered
  receivedQty Int      @default(0)
  // Money, precision/scale (12,2). Applied at the Phase 11 Postgres
  // cutover (precedent: Product.unitCost / ImportRow.unitCost).
  unitCost    Decimal?

  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id])

  @@index([poId])
  @@index([productId])
}

// =====================================================================
// PURCHASE INVOICE — Payables (Phase 27, mirror of Invoice against
// Supplier — hnerve-gap-map.md "Purchases" row). Posts a JournalEntry on
// issue (Purchases/COGS debit — code 5000 — / Accounts Payable credit —
// code 2100) through the EXISTING double-entry engine, bootstrapped the
// same way Invoice bootstraps AR/Revenue. Standalone for now — does not
// require a source PurchaseOrder (PO→bill conversion is a future step,
// same shape as Estimate→Invoice).
// =====================================================================
model PurchaseInvoice {
  id                   String   @id @default(cuid())
  tenantId             String
  purchaseInvoiceNumber String
  supplierId           String
  // DRAFT | UNPAID | PARTIAL | DUE | OVERDUE | PAID | OVERPAID | CANCELLED
  status               String   @default("DRAFT")
  issueDate            DateTime @default(now())
  dueDate              DateTime?
  currency             String   @default("JOD")
  subtotal             Decimal  @default(0)
  taxTotal             Decimal  @default(0)
  total                Decimal  @default(0)
  note                 String?

  // Set once the Purchases/AP journal posts (issue-time). Null while DRAFT.
  journalEntryId String?  @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  supplierRef   Supplier @relation(fields: [supplierId], references: [id])
  lines         PurchaseInvoiceLine[]
  payments      SupplierPayment[]

  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, purchaseInvoiceNumber])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
  @@index([tenantId, issueDate])
}

model PurchaseInvoiceLine {
  id          String   @id @default(cuid())
  purchaseInvoiceId String
  productId   String?
  description String
  quantity    Decimal  @default(1)
  unitPrice   Decimal  @default(0)
  taxRateId   String?
  lineTotal   Decimal  @default(0)

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id])
  taxRate     TaxRate?  @relation(fields: [taxRateId], references: [id])

  @@index([purchaseInvoiceId])
  @@index([productId])
}

// =====================================================================
// SALES ORDERS — fulfillment (Phase 6). DRAFT → CONFIRMED → PARTIAL →
// FULFILLED → CANCELLED. Only FULFILLED/PARTIAL fulfillment writes SOLD
// movements (negative delta). Stock availability is checked at create
// and again at CONFIRMED. customer is an OPAQUE string (FK in Phase 7).
// =====================================================================
model SalesOrder {
  id          String   @id @default(cuid())
  tenantId    String
  soNumber    String   @unique
  customerId  String
  // DRAFT | CONFIRMED | PARTIAL | FULFILLED | CANCELLED
  status      String   @default("DRAFT")
  orderedAt   DateTime @default(now())
  requiredBy  DateTime?
  note        String?

  lines       SalesOrderLine[]
  customerRef Customer  @relation(fields: [customerId], references: [id])

  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, orderedAt])
}

model SalesOrderLine {
  id            String   @id @default(cuid())
  soId          String
  productId     String
  quantity      Int      // ordered
  fulfilledQty  Int      @default(0)
  // Money, precision/scale (12,2). Phase 11 Postgres cutover (precedent above).
  unitPrice     Decimal?

  so            SalesOrder @relation(fields: [soId], references: [id], onDelete: Cascade)
  product       Product    @relation(fields: [productId], references: [id])

  @@index([soId])
  @@index([productId])
}

// =====================================================================
// SUPPLIER / CUSTOMER — real entities (Phase 7). Promotes the opaque
// supplier/customer strings on Product/PurchaseOrder/SalesOrder to
// tenant-scoped FK tables. Forward relation fields are supplierRef /
// customerRef (the scalar names supplier/customer stay as legacy
// columns until the Schema-2 drop, so the relation can't reuse them).
// paymentTerms is a plain string (Phase 8 formalizes). Soft-delete via
// deletedAt; not registered in lib/softDelete.ts (no trash UI),
// consistent with Product / InventoryMovement / PO / SO.
// =====================================================================
model Supplier {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  email         String?
  phone         String?
  address       String?
  paymentTerms  String?  // "Net 30" | "COD" | "Prepaid" — plain string
  notes         String?

  // Phase NS-1 — when this supplier IS another in-system tenant (e.g.
  // the Hotels tenant's "Maha Dairy" supplier maps to the maha-dairy
  // tenant), this stores that tenant's SLUG. Null for external suppliers.
  // Opaque slug string (NOT a Tenant FK) to match the procurement
  // schema's tenantId-as-slug convention end-to-end.
  linkedTenantId String?

  products       Product[]
  purchaseOrders PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  supplierPayments SupplierPayment[]

  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, deletedAt])
  @@index([linkedTenantId])
}

model Customer {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  email         String?
  phone         String?
  address       String?
  paymentTerms  String?
  notes         String?

  salesOrders   SalesOrder[]
  invoices      Invoice[]
  estimates     Estimate[]
  payments      Payment[]
  portalAccount CustomerPortalAccount?

  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, deletedAt])
}

// =====================================================================
// INVOICE — Sales/Billing (Phase 27, docs/spec/ENTITY-ENGINE-PATTERN.md).
// Tenant-scoped opaque tenantId, same family as Product/Supplier/Customer/
// LedgerAccount. Posts a JournalEntry on issue (AR debit / Revenue
// credit) through the EXISTING double-entry engine above — does not
// duplicate it. Numbering allocated from NumberingScheme, not
// generateNumber() (that helper has no persisted per-tenant counter).
// =====================================================================
model Invoice {
  id            String   @id @default(cuid())
  tenantId      String
  invoiceNumber String
  customerId    String
  // DRAFT | UNPAID | PARTIAL | DUE | OVERDUE | PAID | OVERPAID | CANCELLED
  // PARTIAL/PAID/OVERPAID are set by lib/finance/invoicing.ts statusForPaid()
  // whenever a Payment posts against this invoice.
  status        String   @default("DRAFT")
  issueDate     DateTime @default(now())
  dueDate       DateTime?
  currency      String   @default("JOD")
  subtotal      Decimal  @default(0)
  taxTotal      Decimal  @default(0)
  total         Decimal  @default(0)
  note          String?

  // Set once the AR/Revenue journal posts (issue-time). Null while DRAFT.
  journalEntryId String?  @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  customerRef   Customer @relation(fields: [customerId], references: [id])
  lines         InvoiceLine[]
  payments      Payment[]
  // Reverse of Estimate.convertedInvoiceId (unique FK) — set when this
  // invoice was created via /estimates convertToInvoice, null otherwise.
  fromEstimate  Estimate?
  eInvoice      EInvoiceRecord?

  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, issueDate])
}

model InvoiceLine {
  id          String   @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Decimal  @default(1)
  unitPrice   Decimal  @default(0)
  taxRateId   String?
  lineTotal   Decimal  @default(0)

  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id])
  taxRate     TaxRate?  @relation(fields: [taxRateId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

// =====================================================================
// ESTIMATE — Sales/Billing (Phase 27). Same shape as Invoice, no journal
// posting (a quote is not an accounting event). convertToInvoice
// (invoices actions, shared via lib/finance/invoicing.ts) creates a real
// Invoice from an estimate's lines and links back here — one estimate
// converts to at most one invoice (unique FK, mirrors Invoice.journalEntryId).
// =====================================================================
model Estimate {
  id             String   @id @default(cuid())
  tenantId       String
  estimateNumber String
  customerId     String
  // DRAFT | SENT | ACCEPTED | DECLINED | EXPIRED | CONVERTED
  status         String   @default("DRAFT")
  issueDate      DateTime @default(now())
  expiryDate     DateTime?
  currency       String   @default("JOD")
  subtotal       Decimal  @default(0)
  taxTotal       Decimal  @default(0)
  total          Decimal  @default(0)
  note           String?

  convertedInvoiceId String?  @unique
  convertedInvoice   Invoice? @relation(fields: [convertedInvoiceId], references: [id])

  customerRef    Customer @relation(fields: [customerId], references: [id])
  lines          EstimateLine[]

  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, estimateNumber])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
}

model EstimateLine {
  id          String   @id @default(cuid())
  estimateId  String
  productId   String?
  description String
  quantity    Decimal  @default(1)
  unitPrice   Decimal  @default(0)
  taxRateId   String?
  lineTotal   Decimal  @default(0)

  estimate    Estimate  @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id])
  taxRate     TaxRate?  @relation(fields: [taxRateId], references: [id])

  @@index([estimateId])
  @@index([productId])
}

// =====================================================================
// TREASURY — Sales/Billing (Phase 27, hnerve-gap-map.md "Payments" row).
// A physical cash box or bank account. Each treasury owns exactly one
// LedgerAccount (unique FK, bootstrapped at create time — no manual COA
// setup needed) so payments post real double-entry, not just a Payment
// row. Money IN (customer Payments, debit) and OUT (SupplierPayments,
// credit); balance = inflows − outflows. Transfers between treasuries
// are a separate future build (Finance — cash row).
// =====================================================================
model Treasury {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  // CASH | BANK
  type            String   @default("CASH")
  currency        String   @default("JOD")
  // Ledger account code this treasury posts to, e.g. "1000". Chosen at
  // create time (not auto-generated) so it's stable and human-readable
  // in reports.
  accountCode     String
  ledgerAccountId String   @unique
  ledgerAccount   LedgerAccount @relation(fields: [ledgerAccountId], references: [id])

  payments         Payment[]
  supplierPayments SupplierPayment[] @relation("TreasuryOutflows")
  payrollRuns      PayrollRun[]
  cashSessions     CashSession[]
  bankStatements   BankStatement[]

  active          Boolean  @default(true)
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, accountCode])
  @@index([tenantId, active])
}

// =====================================================================
// PAYMENT — a customer payment, optionally applied to one Invoice
// (nullable invoiceId — an on-account payment with no invoice is valid,
// mirrors Daftra's Client Payments). Posts a JournalEntry (Treasury
// debit / AR credit) through the same immutable-once-posted convention
// as Invoice. Deliberately NO delete/update action once created — Posted
// JournalEntries are immutable (decision #2 on JournalEntry above); a
// mistaken payment is corrected with a reversing entry, not an edit.
// =====================================================================
model Payment {
  id            String   @id @default(cuid())
  tenantId      String
  paymentNumber String
  customerId    String
  invoiceId     String?
  treasuryId    String
  amount        Decimal
  currency      String   @default("JOD")
  // CASH | BANK_TRANSFER | CHEQUE | CARD | OTHER
  method        String   @default("CASH")
  paidAt        DateTime @default(now())
  note          String?

  journalEntryId String?  @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  customerRef   Customer @relation(fields: [customerId], references: [id])
  invoice       Invoice? @relation(fields: [invoiceId], references: [id])
  treasury      Treasury @relation(fields: [treasuryId], references: [id])
  // Reverse of BankStatementLine.matchedPaymentId (unique FK) — set once
  // a bank statement line is reconciled against this payment.
  bankStatementLine BankStatementLine?

  createdAt     DateTime @default(now())

  @@unique([tenantId, paymentNumber])
  @@index([tenantId, customerId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, treasuryId])
}

// =====================================================================
// SUPPLIER PAYMENT — payables mirror of Payment: money OUT of a treasury
// to a supplier, optionally applied to one PurchaseInvoice (nullable —
// an on-account payment is valid). Posts a JournalEntry (AP debit /
// Treasury credit). Same immutability convention as Payment: NO
// update/delete action — corrections are reversing entries.
// =====================================================================
model SupplierPayment {
  id                String   @id @default(cuid())
  tenantId          String
  paymentNumber     String
  supplierId        String
  purchaseInvoiceId String?
  treasuryId        String
  amount            Decimal
  currency          String   @default("JOD")
  // CASH | BANK_TRANSFER | CHEQUE | CARD | OTHER
  method            String   @default("CASH")
  paidAt            DateTime @default(now())
  note              String?

  journalEntryId String?  @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  supplierRef     Supplier         @relation(fields: [supplierId], references: [id])
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])
  treasury        Treasury         @relation("TreasuryOutflows", fields: [treasuryId], references: [id])
  // Reverse of BankStatementLine.matchedSupplierPaymentId (unique FK).
  bankStatementLine BankStatementLine?

  createdAt     DateTime @default(now())

  @@unique([tenantId, paymentNumber])
  @@index([tenantId, supplierId])
  @@index([tenantId, purchaseInvoiceId])
  @@index([tenantId, treasuryId])
}

// =====================================================================
// FIXED ASSET — hnerve-gap-map.md "Fixed assets" row. Straight-line
// depreciation only in v1 (Daftra offers 4 methods; the others are a
// method-column away). Acquisition posts Fixed Assets (1500) debit /
// Accounts Payable (2100) credit. Monthly depreciation runs post
// Depreciation Expense (6100) debit / Accumulated Depreciation (1590,
// contra-asset) credit via DepreciationEntry rows — one per asset per
// month, unique-constrained so a run can never double-post.
// =====================================================================
model FixedAsset {
  id              String   @id @default(cuid())
  tenantId        String
  assetNumber     String
  name            String
  category        String?
  purchaseDate    DateTime @default(now())
  purchaseCost    Decimal
  salvageValue    Decimal  @default(0)
  usefulLifeMonths Int
  // STRAIGHT_LINE (only method in v1)
  method          String   @default("STRAIGHT_LINE")
  // ACTIVE | DISPOSED
  status          String   @default("ACTIVE")
  note            String?

  // Acquisition journal entry (1500 debit / 2100 credit).
  journalEntryId String?  @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  depreciation   DepreciationEntry[]

  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, assetNumber])
  @@index([tenantId, status])
}

model DepreciationEntry {
  id          String   @id @default(cuid())
  tenantId    String
  assetId     String
  periodYear  Int
  periodMonth Int // 1-12
  amount      Decimal

  journalEntryId String?  @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  asset       FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([assetId, periodYear, periodMonth])
  @@index([tenantId, periodYear, periodMonth])
}

// =====================================================================
// TAX RATE — config prerequisite (Daftra: Tax Settings). Blocks real
// invoicing until it exists.
// =====================================================================
model TaxRate {
  id        String   @id @default(cuid())
  tenantId  String
  name      String   // "16% GST", "0% Exempt"
  rate      Decimal  // 0.16
  active    Boolean  @default(true)

  invoiceLines  InvoiceLine[]
  estimateLines EstimateLine[]
  purchaseInvoiceLines PurchaseInvoiceLine[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
}

// =====================================================================
// NUMBERING SCHEME — config prerequisite (Daftra: Auto Number Settings).
// Per-tenant, per-doc-type persisted sequence. generateNumber()
// (lib/utils/utils.ts) is a one-shot generator with no persisted
// counter/prefix — this is the gap that blocks configurable numbering.
// =====================================================================
model NumberingScheme {
  id        String   @id @default(cuid())
  tenantId  String
  docType   String   // "INVOICE" | "ESTIMATE" | "PURCHASE_ORDER" | ...
  prefix    String   @default("")
  nextValue Int      @default(1)
  padTo     Int      @default(6)

  @@unique([tenantId, docType])
}

// =====================================================================
// BANK RECONCILIATION — hnerve-gap-map.md "Bank reconciliation" row
// (docs/HOURANI-ERP-GAPS.md #1 🔴). A BankStatement is one imported/pasted
// statement for one Treasury; its lines are matched against existing
// Payment (money in) / SupplierPayment (money out) rows by
// lib/finance/reconciliation.ts. Matching NEVER creates a Payment — it
// only links a line to one that already exists, so the ledger stays the
// single source of truth and reconciliation can't double-post money.
// tenantId is denormalized onto BankStatementLine (same precedent as
// Booking/Crop/CouncilReply) so the tenant middleware filters without a
// join through the parent statement.
// =====================================================================
model BankStatement {
  id              String   @id @default(cuid())
  tenantId        String
  treasuryId      String
  statementDate   DateTime @default(now())
  startingBalance Decimal  @default(0)
  endingBalance   Decimal  @default(0)
  note            String?

  treasury        Treasury @relation(fields: [treasuryId], references: [id])
  lines           BankStatementLine[]

  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, treasuryId])
  @@index([tenantId, statementDate])
}

model BankStatementLine {
  id              String   @id @default(cuid())
  tenantId        String
  bankStatementId String
  date            DateTime
  description     String
  reference       String?
  // Signed: positive = deposit (money in, matches against Payment),
  // negative = withdrawal (money out, matches against SupplierPayment).
  amount          Decimal
  // UNMATCHED | MATCHED | IGNORED
  status          String   @default("UNMATCHED")

  matchedPaymentId         String?  @unique
  matchedSupplierPaymentId String?  @unique
  matchedPayment           Payment?         @relation(fields: [matchedPaymentId], references: [id])
  matchedSupplierPayment   SupplierPayment? @relation(fields: [matchedSupplierPaymentId], references: [id])

  statement       BankStatement @relation(fields: [bankStatementId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@index([bankStatementId])
  @@index([tenantId, bankStatementId, status])
}

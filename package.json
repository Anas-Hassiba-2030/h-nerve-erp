{
  "name": "bmv2026-erp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma db push --accept-data-loss && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:push": "node scripts/ops/guard-not-prod.js && prisma db push",
    "db:seed": "node scripts/ops/guard-not-prod.js && tsx prisma/seed.ts",
    "db:seed-demo": "tsx prisma/seed-demo.ts",
    "db:seed-demo-extras": "tsx scripts/seed/seed-demo-extras.ts",
    "seed:prod": "tsx scripts/seed/seed-production.ts",
    "db:reset": "node scripts/ops/guard-not-prod.js && prisma db push --force-reset && tsx prisma/seed.ts",
    "db:fresh": "node scripts/ops/guard-not-prod.js && prisma db push --force-reset && tsx prisma/seed.ts && tsx scripts/seed/seed-demo-extras.ts",
    "db:studio": "prisma studio",
    "brain:mcp": "tsx scripts/ops/brain-mcp.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "esbuild": "^0.28.0",
    "iron-session": "8.0.4",
    "lucide-react": "0.460.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.3",
    "tailwind-merge": "2.5.4",
    "zod": "3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "playwright": "^1.60.0",
    "postcss": "8.4.49",
    "postcss-import": "^16.1.1",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.14",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "^4.1.6"
  }
}

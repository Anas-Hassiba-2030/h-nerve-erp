{
  "name": "bmv2026-erp",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "vite": "^8.1.4"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/ops/guard-not-prod.js && prisma generate && node scripts/build/extract-datamodel.mjs && prisma db push --accept-data-loss && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:push": "node scripts/ops/guard-not-prod.js && prisma db push",
    "db:seed": "node scripts/ops/guard-not-prod.js && tsx scripts/seed/seed.ts",
    "db:seed-demo": "tsx scripts/seed/seed-demo.ts",
    "db:seed-demo-extras": "tsx scripts/seed/seed-demo-extras.ts",
    "seed:prod": "tsx scripts/seed/seed-production.ts",
    "db:reset": "node scripts/ops/guard-not-prod.js && prisma db push --force-reset && tsx scripts/seed/seed.ts",
    "db:fresh": "node scripts/ops/guard-not-prod.js && prisma db push --force-reset && tsx scripts/seed/seed.ts && tsx scripts/seed/seed-demo-extras.ts",
    "db:studio": "prisma studio",
    "cf:build": "prisma generate && node scripts/build/extract-datamodel.mjs && opennextjs-cloudflare build && node scripts/build/patch-wasm-modules.mjs",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "brain:mcp": "tsx scripts/ops/brain-mcp.ts",
    "brain:doctor": "tsx scripts/verify/brain-db-link.ts",
    "brain:mcp:smoke": "tsx scripts/verify/brain-mcp-smoke.ts",
    "postinstall": "prisma generate && node scripts/build/extract-datamodel.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/adapter-neon": "6.19.3",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "esbuild": "^0.28.0",
    "iron-session": "8.0.4",
    "lucide-react": "0.460.0",
    "next": "16.2.9",
    "pg": "^8.22.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "2.5.4",
    "ws": "^8.21.0",
    "zod": "3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@types/ws": "^8.18.1",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.0",
    "eslint-config-next": "16.2.9",
    "playwright": "^1.60.0",
    "postcss": "8.5.10",
    "postcss-import": "^16.1.1",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.14",
    "tsx": "4.22.4",
    "typescript": "5.6.3",
    "vitest": "^4.1.6",
    "wrangler": "^4.110.0"
  }
}

// =====================================================================
// HR / PAYROLL (Phase 27 — hnerve-gap-map.md "HR" row, split WFM+HRM
// per docs/ERP-KNOWLEDGE-BASE.md; this is the HRM half — headcount,
// leave, payroll. Workforce-management/scheduling deferred). Payroll
// posts straight into the same JournalEntry engine as invoicing.ts /
// purchasing.ts / assets.ts: Salary Expense debit / Treasury credit,
// one entry per run. No payable step — salaries are paid same-run,
// matching Daftra's payroll-run behavior.
// =====================================================================
model Employee {
  id              String    @id @default(cuid())
  tenantId        String
  employeeNumber  String
  name            String
  email           String?
  phone           String?
  department      String?
  position        String?
  hireDate        DateTime  @default(now())
  terminationDate DateTime?
  baseSalary      Decimal   @default(0)
  // ACTIVE | ON_LEAVE | TERMINATED
  status          String    @default("ACTIVE")
  // Optional link to a login account (not every employee has one).
  userId          String?   @unique
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  note            String?

  leaveRequests LeaveRequest[]
  payslips      Payslip[]
  attendance    Attendance[]
  shiftAssignments ShiftAssignment[]
  timesheetEntries TimesheetEntry[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, employeeNumber])
  @@index([tenantId, status])
}

model LeaveRequest {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // ANNUAL | SICK | UNPAID | OTHER
  type       String   @default("ANNUAL")
  startDate  DateTime
  endDate    DateTime
  days       Int
  // PENDING | APPROVED | REJECTED
  status     String   @default("PENDING")
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([employeeId])
}

model PayrollRun {
  id          String   @id @default(cuid())
  tenantId    String
  periodYear  Int
  periodMonth Int // 1-12
  treasuryId  String
  treasury    Treasury @relation(fields: [treasuryId], references: [id])
  totalAmount Decimal  @default(0)
  // POSTED (only state in v1 — a run is created already posted, like
  // a depreciation run; corrections are reversing entries, not edits).
  status      String   @default("POSTED")

  journalEntryId String?      @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  payslips Payslip[]

  createdAt DateTime @default(now())

  @@unique([tenantId, periodYear, periodMonth])
  @@index([tenantId, periodYear, periodMonth])
}

model Payslip {
  id           String     @id @default(cuid())
  tenantId     String
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id])
  baseSalary   Decimal
  allowances   Decimal    @default(0)
  deductions   Decimal    @default(0)
  netPay       Decimal

  createdAt DateTime @default(now())

  @@unique([payrollRunId, employeeId])
  @@index([tenantId])
}

// =====================================================================
// ATTENDANCE + SHIFTS — docs/HOURANI-ERP-GAPS.md #7 🟠. Payroll runs off
// Employee.baseSalary alone today; hotels and a farm both run shift
// labour where the flat monthly figure is wrong the moment someone
// works overtime. Shift is a reusable roster template (a name + a time
// window); ShiftAssignment puts one employee on one shift for one
// calendar day; Attendance is the actual clock-in/out for that day,
// whose overtime hours feed into PayrollRun.allowances (see
// lib/hr/attendance.ts + lib/hr/payroll.ts's overtime wiring).
// =====================================================================
model Shift {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  // "HH:MM" 24h, e.g. "07:00" / "15:00". Plain strings, not DateTime —
  // a shift is a recurring daily WINDOW, not a specific day.
  startTime String
  endTime   String
  active    Boolean  @default(true)

  assignments ShiftAssignment[]

  deletedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([tenantId, name])
  @@index([tenantId, active])
}

model ShiftAssignment {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  shiftId    String
  date       DateTime

  employee   Employee @relation(fields: [employeeId], references: [id])
  shift      Shift    @relation(fields: [shiftId], references: [id])

  createdAt  DateTime @default(now())

  // One shift per employee per day — reassigning replaces, never stacks.
  @@unique([employeeId, date])
  @@index([tenantId, date])
  @@index([shiftId])
}

model Attendance {
  id          String    @id @default(cuid())
  tenantId    String
  employeeId  String
  date        DateTime
  clockIn     DateTime?
  clockOut    DateTime?
  // PRESENT | ABSENT | LATE — set at clock-in (LATE if past the
  // assigned shift's startTime); ABSENT rows are created explicitly by
  // a manager, never inferred from a missing clock-in.
  status      String    @default("PRESENT")
  note        String?

  employee    Employee  @relation(fields: [employeeId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, date])
  @@index([tenantId, date])
}

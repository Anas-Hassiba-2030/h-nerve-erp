// =====================================================================
// AI INSIGHTS
// =====================================================================

model AIInsight {
  id          String   @id @default(cuid())
  module      String
  severity    String   @default("INFO")
  title       String
  body        String
  // Phase i18n — English copies so the insight feed translates with the UI.
  // Nullable: legacy/user-generated insights without an English version fall
  // back to the Arabic title/body at render time.
  titleEn     String?
  bodyEn      String?
  // Phase 22 — engine's confidence in this signal, [0,1]. Drives the
  // TrustChip on /insights. Nullable: user-authored insights leave it null
  // (the chip then hides), engine-authored ones populate it from
  // confidenceFor(severity) in lib/aiEngine.ts.
  confidence  Float?
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  // Phase ISO-4 — workspace scoping. NULLABLE on purpose: a NULL companyId
  // is a GROUP-WIDE insight (engine heuristics like cross-company synergy /
  // group cash-burn, plus an ADMIN's manual notes) and stays visible across
  // every workspace; a non-null companyId pins the insight to one company so
  // a workspace-pinned operator only sees its own company's signals + the
  // group-wide ones. Mirrors AlertRule.scopeCompanyId's null-is-group-wide
  // convention. SetNull so deleting a company demotes its insights to
  // group-wide rather than cascading them away. Scoped via the
  // SHARED_COMPANY_SCOPED_MODELS plane in lib/tenancy/workspaceScope.ts.
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([companyId])
}

// =====================================================================
// ALERT RULES — threshold-based monitors that auto-create AIInsights
// =====================================================================

model AlertRule {
  id          String   @id @default(cuid())
  // "REVENUE_DROP" | "OCCUPANCY_HIGH" | "OCCUPANCY_LOW" | "EXPIRY_SOON"
  // | "FARM_CRITICAL" | "ESG_GAP" | "STALE_FORECAST" | "MARGIN_TOP"
  // | "CUSTOM_REVENUE" | "CUSTOM_EXPENSE"
  kind        String
  name        String
  nameEn      String?
  description String?
  // "INFO" | "WARN" | "CRITICAL" | "OPPORTUNITY"
  severity    String   @default("WARN")
  // Threshold value — interpretation depends on kind
  // (e.g. 0.25 for revenue_drop = trigger when -25%)
  threshold   Float    @default(0)
  // Optional scope — companyId or null for group-wide
  scopeCompanyId String?
  scopeCompany   Company? @relation(fields: [scopeCompanyId], references: [id], onDelete: SetNull)
  isActive    Boolean  @default(true)
  // Cooldown — minimum hours between triggers for same rule
  cooldownHours Int    @default(24)
  lastTriggered DateTime?
  triggerCount  Int    @default(0)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, kind])
  @@index([scopeCompanyId])
}

// =====================================================================
// DIGEST — weekly executive intelligence digests generated by the AI engine
// =====================================================================

model Digest {
  id           String   @id @default(cuid())
  // Calendar window the digest covers (inclusive on both ends).
  weekStart    DateTime
  weekEnd      DateTime
  // Long-form Markdown / multi-paragraph body.
  body         String
  // Short executive summary (1–3 sentences) shown in the list view.
  summary      String
  // How many engine insights this digest references.
  insightCount Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([weekStart])
}

// =====================================================================
// BRAIN INSIGHT — Phase 10. Rule-based intelligence findings produced
// by lib/intelligence/engine.ts (the Brain reads operational data and
// never writes it back). tenantId is the same OPAQUE caller label as
// Product/ImportLog (no Tenant FK). `metadata` is JSON-encoded String —
// Prisma's sqlite connector has no Json type (codebase convention, cf.
// TenantImportMapping.fieldMapJson). Active insight = resolvedAt IS
// NULL AND dismissedAt IS NULL. The @@unique drives the per-product
// upsert dedup; import anomalies (productId NULL) dedup in-engine on
// metadata.importLogId since SQLite treats NULLs as distinct.
// =====================================================================
model BrainInsight {
  id          String    @id @default(cuid())
  tenantId    String
  type        String // LOW_STOCK | REORDER_RECOMMENDATION | STALE_PRODUCT | IMPORT_ANOMALY
  severity    String // INFO | WARNING | CRITICAL
  title       String
  body        String
  metadata    String    @default("{}") // JSON-encoded (SQLite has no Json type)

  productId   String?
  supplierId  String?
  warehouseId String?

  resolvedAt  DateTime?
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, type, productId])
  @@index([tenantId, type])
  @@index([tenantId, severity])
  @@index([tenantId, resolvedAt, dismissedAt])
  @@index([productId])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // LOCAL DEMO default = sqlite (reliable; Neon free-tier dropped
  // connections and crash-looped the demo). PILOT path = set provider
  // back to "postgresql" + point DATABASE_URL at Neon. Phase B work is
  // preserved and documented in docs/OPERATING-PROTOCOL.md §6.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =====================================================================
// IDENTITY & ACCESS — gamified
// =====================================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  // "ADMIN" | "EXECUTIVE" | "MANAGER" | "STAFF"
  role         String   @default("STAFF")
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title        String?
  avatarColor  String   @default("emerald")

  // -- Gamification (chess ranks)
  // "PAWN" | "BISHOP" | "KNIGHT" | "QUEEN" | "KING"
  rank         String   @default("PAWN")
  xp           Int      @default(0)
  loginCount   Int      @default(0)
  bonusPercent Float    @default(0)
  lastLoginAt  DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions Transaction[]
  forecasts    SupplyForecast[]
  insights     AIInsight[]
  tasks        Task[] @relation("TaskAssignee")
  achievements UserAchievement[]
  threads      ThreadParticipant[]
  messages     Message[]
  alertRules   AlertRule[]
}

// =====================================================================
// HOURANI GROUP — HOLDINGS REGISTRY
// =====================================================================

model Company {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  nameEn      String
  // "HOSPITALITY" | "DAIRY" | "AGRICULTURE" | "EDUCATION" | "INVESTMENT" | "TRADE"
  sector      String
  country     String   @default("JO")
  city        String?
  foundedYear Int?
  employees   Int      @default(0)
  // "ACTIVE" | "PAUSED" | "RAMPING"
  status      String   @default("ACTIVE")
  description String?
  brandColor  String   @default("emerald")
  // ticker (optional) — links into MarketStock for live tracking
  ticker      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  hotels        Hotel[]
  dairyBatches  DairyBatch[]
  farms         Farm[]
  programs      Program[]
  transactions  Transaction[]
  forecastsOut  SupplyForecast[] @relation("ForecastSource")
  forecastsIn   SupplyForecast[] @relation("ForecastTarget")
  futureProjects FutureProject[]
  esgScores     SustainabilityScore[]
  marketStocks  MarketStock[]
  alertRules    AlertRule[]
}

// =====================================================================
// HOSPITALITY
// =====================================================================

model Hotel {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  nameEn      String?
  city        String
  country     String   @default("JO")
  tier        String   @default("BUSINESS")
  totalRooms  Int      @default(0)
  starRating  Int      @default(4)
  baselineADR Float    @default(120)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings Booking[]
}

model Booking {
  id        String   @id @default(cuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  reference String   @unique
  guestName String
  roomType  String   @default("STANDARD")
  rooms     Int      @default(1)
  guests    Int      @default(2)
  checkIn   DateTime
  checkOut  DateTime
  revenue   Float    @default(0)
  status    String   @default("CONFIRMED")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================================================================
// DAIRY
// =====================================================================

model DairyBatch {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  batchNumber    String   @unique
  product        String
  productAr      String
  quantityLiters Float    @default(0)
  qualityGrade   String   @default("A")
  fatContent     Float    @default(3.5)
  productionDate DateTime
  expiryDate     DateTime
  status         String   @default("IN_PRODUCTION")
  destination    String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// =====================================================================
// AGRICULTURE
// =====================================================================

model Farm {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  nameEn        String?
  type          String
  location      String
  areaDunum     Float    @default(0)
  tempC         Float?
  humidity      Float?
  soilMoisture  Float?
  alertLevel    String   @default("OK")
  lastReadAt    DateTime?
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  crops Crop[]
}

model Crop {
  id              String   @id @default(cuid())
  farmId          String
  farm            Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  name            String
  variety         String?
  plantedAt       DateTime
  expectedHarvest DateTime
  expectedYieldKg Float    @default(0)
  actualYieldKg   Float?
  status          String   @default("GROWING")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// =====================================================================
// EDUCATION
// =====================================================================

model Program {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  nameEn      String?
  founder     String
  vertical    String   @default("OTHER")
  stage       String   @default("INTAKE")
  cohort      String   @default("2026")
  fundingJod  Float    @default(0)
  teamSize    Int      @default(1)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// =====================================================================
// PREDICTIVE SUPPLY CHAIN
// =====================================================================

model SupplyForecast {
  id              String   @id @default(cuid())
  sourceCompanyId String
  source          Company  @relation("ForecastSource", fields: [sourceCompanyId], references: [id], onDelete: Cascade)
  targetCompanyId String
  target          Company  @relation("ForecastTarget", fields: [targetCompanyId], references: [id], onDelete: Cascade)
  category        String
  productLabel    String
  unit            String   @default("kg")
  predictedDemand Float
  confidence      Float    @default(0.7)
  periodStart     DateTime
  periodEnd       DateTime
  signal          String
  status          String   @default("DRAFT")
  generatedById   String?
  generatedBy     User?    @relation(fields: [generatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?
}

// =====================================================================
// FINANCE
// =====================================================================

model Transaction {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reference   String   @unique
  kind        String
  category    String
  amount      Float
  currency    String   @default("JOD")
  description String?
  occurredAt  DateTime
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// =====================================================================
// AI INSIGHTS
// =====================================================================

model AIInsight {
  id          String   @id @default(cuid())
  module      String
  severity    String   @default("INFO")
  title       String
  body        String
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

// =====================================================================
// TASKS — gamified work for employees
// =====================================================================

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  // "CORE" (mandated) or "SIDE" (bonus, optional)
  kind        String   @default("CORE")
  // "TODO" | "IN_PROGRESS" | "DONE" | "BLOCKED"
  status      String   @default("TODO")
  // "LOW" | "MEDIUM" | "HIGH" | "URGENT"
  priority    String   @default("MEDIUM")
  // sector tag links task to its module
  module      String   @default("GENERAL")
  points      Int      @default(10)
  dueAt       DateTime?
  completedAt DateTime?
  assigneeId  String?
  assignee    User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

// =====================================================================
// ACHIEVEMENTS — chess ranks + medals
// =====================================================================

model Achievement {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  nameEn      String
  description String
  // "BRONZE" | "SILVER" | "GOLD" | "PLATINUM"
  tier        String   @default("BRONZE")
  icon        String   @default("Trophy")
  threshold   Int      @default(0)
  createdAt   DateTime @default(now())

  earned UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  earnedAt      DateTime    @default(now())

  @@unique([userId, achievementId])
}

// =====================================================================
// FUTURE PROJECTS — pipeline per company
// =====================================================================

model FutureProject {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  // "IDEA" | "RESEARCH" | "PLANNED" | "APPROVED" | "IN_PROGRESS" | "ON_HOLD" | "DONE"
  stage       String   @default("IDEA")
  budgetJod   Float    @default(0)
  priority    String   @default("MEDIUM")
  startQuarter String?  // e.g. "2026-Q3"
  targetQuarter String? // e.g. "2027-Q2"
  kpis        String?  // free text
  ownerName   String?
  progressPct Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

// =====================================================================
// MARKETS — global + regional stocks tracking
// =====================================================================

model MarketStock {
  id         String   @id @default(cuid())
  ticker     String   @unique
  label      String
  labelAr    String?
  exchange   String   // "NYSE" | "NASDAQ" | "ASE" | "TADAWUL" | "DFM"
  currency   String   @default("USD")
  lastPrice  Float    @default(0)
  changePct  Float    @default(0)
  // optional link to a Hourani company
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  region     String   @default("MENA") // "MENA" | "EU" | "US" | "ASIA"
  // serialized JSON of recent prices for sparkline
  history    String   @default("[]")
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

// =====================================================================
// SUSTAINABILITY — ESG scoring per company per period
// =====================================================================

model SustainabilityScore {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // "Q1" | "Q2" | "Q3" | "Q4" | "H1" | "H2" | "FY"
  period          String
  year            Int
  environmentalScore Float   @default(0)  // 0-100
  socialScore     Float    @default(0)
  governanceScore Float    @default(0)
  overall         Float    @default(0)
  carbonTons      Float    @default(0)
  waterCubicM     Float    @default(0)
  renewablePct    Float    @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, period, year])
}

// =====================================================================
// ALERT RULES — threshold-based monitors that auto-create AIInsights
// =====================================================================

model AlertRule {
  id          String   @id @default(cuid())
  // "REVENUE_DROP" | "OCCUPANCY_HIGH" | "OCCUPANCY_LOW" | "EXPIRY_SOON"
  // | "FARM_CRITICAL" | "ESG_GAP" | "STALE_FORECAST" | "MARGIN_TOP"
  // | "CUSTOM_REVENUE" | "CUSTOM_EXPENSE"
  kind        String
  name        String
  nameEn      String?
  description String?
  // "INFO" | "WARN" | "CRITICAL" | "OPPORTUNITY"
  severity    String   @default("WARN")
  // Threshold value — interpretation depends on kind
  // (e.g. 0.25 for revenue_drop = trigger when -25%)
  threshold   Float    @default(0)
  // Optional scope — companyId or null for group-wide
  scopeCompanyId String?
  scopeCompany   Company? @relation(fields: [scopeCompanyId], references: [id], onDelete: SetNull)
  isActive    Boolean  @default(true)
  // Cooldown — minimum hours between triggers for same rule
  cooldownHours Int    @default(24)
  lastTriggered DateTime?
  triggerCount  Int    @default(0)
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, kind])
  @@index([scopeCompanyId])
}

// =====================================================================
// INTERNAL MESSAGING — peer-to-peer chat between officials
// =====================================================================

model MessageThread {
  id          String   @id @default(cuid())
  // "DIRECT" | "GROUP" | "ENTITY"  (ENTITY = pinned to a specific record like a forecast/booking/etc.)
  kind        String   @default("DIRECT")
  // For ENTITY threads — what record does this discussion attach to?
  entityType  String?
  entityId    String?
  // Optional title (for groups/entity threads)
  title       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participants ThreadParticipant[]
  messages     Message[]

  @@index([entityType, entityId])
}

model ThreadParticipant {
  id          String        @id @default(cuid())
  threadId    String
  thread      MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Last time this user opened the thread — drives unread count
  lastReadAt  DateTime?
  // True when user muted this thread
  muted       Boolean       @default(false)
  joinedAt    DateTime      @default(now())

  @@unique([threadId, userId])
  @@index([userId])
}

model Message {
  id        String        @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  // Optional reference — a forecast id, booking ref, etc., the author wants to highlight
  refType   String?
  refId     String?
  // For reactions later
  meta      String?
  createdAt DateTime      @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  @@index([threadId, createdAt])
  @@index([authorId])
}

// =====================================================================
// PINS — per-user favorites/bookmarks across any entity in the system
// =====================================================================

model Pin {
  id         String   @id @default(cuid())
  userId     String
  // "COMPANY" | "HOTEL" | "BOOKING" | "DAIRY" | "FARM" | "PROGRAM" | "FORECAST" | "INSIGHT" | "TASK" | "PROJECT" | "TRANSACTION"
  entityType String
  entityId   String
  // Cached display values so we don't have to join across many tables.
  label      String
  labelEn    String?
  href       String
  icon       String?  // lucide icon key
  createdAt  DateTime @default(now())

  @@unique([userId, entityType, entityId])
  @@index([userId])
}

// =====================================================================
// ACTIVITY LOG — audit trail across the system
// =====================================================================

model ActivityLog {
  id          String   @id @default(cuid())
  // "CREATE" | "UPDATE" | "DELETE" | "RESTORE" | "LOGIN" | "EXPORT" | "FORECAST" | "INSIGHT"
  action      String
  // "BOOKING" | "DAIRY" | "FARM" | "PROGRAM" | "FORECAST" | "INSIGHT" | "TASK" | "PROJECT" | "TRANSACTION" | "USER" | "COMPANY"
  entity      String
  entityId    String?
  // human-friendly summary in Arabic
  summary     String
  summaryEn   String?
  // serialized JSON of metadata (before/after)
  meta        String?
  actorId     String?
  actorName   String?
  module      String?  // sector/section
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorId])
}

// =====================================================================
// DIGEST — weekly executive intelligence digests generated by the AI engine
// =====================================================================

model Digest {
  id           String   @id @default(cuid())
  // Calendar window the digest covers (inclusive on both ends).
  weekStart    DateTime
  weekEnd      DateTime
  // Long-form Markdown / multi-paragraph body.
  body         String
  // Short executive summary (1–3 sentences) shown in the list view.
  summary      String
  // How many engine insights this digest references.
  insightCount Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([weekStart])
}

// =====================================================================
// THE BRAIN — causal graph substrate (Phase 1 of docs/PHASES-INTELLIGENCE.md)
// Every business entity becomes a BrainNode; relationships are BrainEdges
// with weight ∈ [-1,1] and confidence ∈ [0,1]. This is the substrate the
// simulator propagates over and the narrator cites.
// =====================================================================

model BrainNode {
  id            String   @id @default(cuid())
  // "Hotel" | "Booking" | "Room" | "DairyBatch" | "MilkSource" | "Farm" |
  // "Crop" | "SensorReading" | "Program" | "Cohort" | "Transaction" |
  // "Account" | "Forecast" | "Plan" | "Insight" | "Company" | "User"
  kind          String
  // The id of the underlying domain row (when applicable).
  refId         String?
  label         String
  // Small bag of numbers/labels per node, JSON-encoded, e.g.
  // {"occupancy":0.78,"sector":"HOSPITALITY","revenue":127335}
  payloadJson   String   @default("{}")
  // Optional centrality / "weight in the system" — recomputed periodically.
  importance    Float    @default(0)
  // When this snapshot of the node was taken.
  ts            DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  outgoing      BrainEdge[] @relation("EdgeFrom")
  incoming      BrainEdge[] @relation("EdgeTo")

  @@index([kind])
  @@index([refId])
  @@index([ts])
}

model BrainEdge {
  id              String   @id @default(cuid())
  fromId          String
  from            BrainNode @relation("EdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId            String
  to              BrainNode @relation("EdgeTo", fields: [toId], references: [id], onDelete: Cascade)
  // "structural" (FK from schema) | "causal" (hand-authored) | "learned" | "manual"
  kind            String   @default("structural")
  // Direction-aware causal weight: positive = more source → more target.
  weight          Float    @default(0)
  // [0,1] — how confident the brain is that this edge is real.
  confidence      Float    @default(0.6)
  // How many observations support this edge (used by feedback loop).
  evidenceCount   Int      @default(0)
  // Free-form description used by the narrator when citing this edge.
  rationale       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([fromId, toId, kind])
  @@index([fromId])
  @@index([toId])
  @@index([kind])
}

// =====================================================================
// THE COUNCIL — Phase 3 of docs/PHASES-INTELLIGENCE.md
// A panel of domain agents debates each decision; a moderator synthesizes.
// Sessions are persisted so users can replay any past deliberation.
// =====================================================================

model CouncilSession {
  id              String   @id @default(cuid())
  topic           String
  // JSON array of BrainNode ids that scope the discussion (subgraph refs).
  contextRefs     String   @default("[]")
  // The synthesized recommendation produced by the Moderator.
  recommendation  String?
  // [0,1] — moderator's confidence in the recommendation.
  confidence      Float?
  // Optional dissent note when one agent strongly disagreed.
  dissentNote     String?
  // "RUNNING" | "DONE" | "FAILED"
  status          String   @default("RUNNING")
  ranAt           DateTime @default(now())
  durationMs      Int?
  // Whether any voice in the session was a real LLM call (vs stub).
  usedLiveLlm     Boolean  @default(false)

  voices          CouncilVoice[]

  createdAt       DateTime @default(now())

  @@index([ranAt])
  @@index([status])
}

model CouncilVoice {
  id              String   @id @default(cuid())
  sessionId       String
  session         CouncilSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // "hospitality-expert" | "dairy-expert" | "agri-expert" | "finance-brain" | "risk-officer" | "moderator"
  agentId         String
  speakerLabelAr  String
  speakerLabelEn  String
  // "support" | "oppose" | "qualify" | "moderate"
  position        String
  // The agent's main argument — editorial paragraph.
  thesis          String
  // JSON array of evidence items: [{ ref, weight, label }, ...]
  evidenceJson    String   @default("[]")

  orderIndex      Int      @default(0)
  llmModel        String?
  isStub          Boolean  @default(false)

  createdAt       DateTime @default(now())

  @@index([sessionId, orderIndex])
}

// =====================================================================
// THE NARRATOR — editorial cache (Phase 4 of docs/PHASES-INTELLIGENCE.md)
// Same input always returns the same prose until the row expires. Keeps
// LLM cost bounded and tooltip latency at zero on repeat hovers.
// =====================================================================

model Narrative {
  id          String   @id @default(cuid())
  // Tenant scope. Default for single-tenant deployments.
  scope       String   @default("default")
  // What the narrative is ABOUT — "revenue" | "occupancy" | "dairy-expiry" | etc.
  topic       String
  // "headline" (6-12 words) | "editorial" (60-120 words) | "executive" (200-400 words)
  register    String
  locale      String   // "ar" | "en"
  // Stable hash of the structured facts input — SHA-1 of canonical JSON.
  factsHash   String
  text        String
  model       String?
  isStub      Boolean  @default(false)
  ms          Int?
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@unique([scope, topic, register, locale, factsHash])
  @@index([expiresAt])
  @@index([scope, topic])
}

// =====================================================================
// THE PLANNER — Phase 5 of docs/PHASES-INTELLIGENCE.md
// Insights become committed action plans with owners, deadlines, target
// outcome, and a rollback condition. The brain proposes; the user commits.
// =====================================================================

model Plan {
  id                      String   @id @default(cuid())

  // What this plan is trying to accomplish (1 line, bilingual).
  goal                    String
  goalEn                  String?

  // Editorial paragraph explaining why we're doing this.
  rationale               String?
  rationaleEn             String?

  // Target outcome — the metric we expect to move and by how much, by when.
  targetMetric            String   // "occupancy" | "revenue" | "expiry_risk" | "margin" | etc.
  targetDelta             Float    // signed relative change e.g. +0.12 = +12%
  targetDeadline          DateTime

  // Simulator-projected delta (Phase 2) for the same metric.
  projectedDelta          Float?
  // [0,1] confidence in the projection (chained from underlying edges).
  confidence              Float?

  // Rollback — if this trigger fires after commit, we revert.
  rollbackCondition       String?
  rollbackConditionEn     String?

  // "DRAFT" | "ACTIVE" | "DONE" | "ABANDONED" | "ROLLED_BACK"
  status                  String   @default("DRAFT")

  // Source of this plan (optional — what produced it).
  sourceInsightId         String?
  sourceCouncilSessionId  String?

  createdAt               DateTime @default(now())
  committedAt             DateTime?
  completedAt             DateTime?

  // Author / committer (optional — who pressed Commit).
  committedById           String?

  steps                   PlanStep[]

  @@index([status])
  @@index([sourceInsightId])
  @@index([sourceCouncilSessionId])
  @@index([createdAt])
}

model PlanStep {
  id            String   @id @default(cuid())
  planId        String
  plan          Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  orderIndex    Int

  // The action to take, in the active voice (1-2 sentences).
  action        String
  actionEn      String?

  // The role responsible (e.g. "PROCUREMENT", "CFO", "OPS_DAIRY", "OPS_HOTEL").
  // Roles are intentionally string-typed so industry packs can register their own.
  ownerRole     String

  // Optional concrete user assignment.
  ownerUserId   String?

  // How long this step is expected to take (estimator input).
  durationDays  Int      @default(7)

  // "PENDING" | "IN_PROGRESS" | "DONE" | "BLOCKED"
  status        String   @default("PENDING")

  notes         String?

  createdAt     DateTime @default(now())
  completedAt   DateTime?

  @@index([planId, orderIndex])
  @@index([status])
}

// =====================================================================
// THE MEMORY LAKE — Phase 6 of docs/PHASES-INTELLIGENCE.md
// Long-term episodic memory. Every meaningful past event lives here with
// a stored vector. New situations search the lake for analogies.
// =====================================================================

model Memory {
  id            String   @id @default(cuid())
  // When the remembered event occurred.
  occurredAt    DateTime
  // "HOTELS" | "DAIRY" | "FARMS" | "EDUCATION" | "FINANCE" | "GROUP" | etc.
  module        String
  // Bilingual headline (1 line, present tense, narrative voice).
  headlineAr    String
  headlineEn    String
  // Bilingual body — 2-4 sentences telling the story.
  bodyAr        String
  bodyEn        String
  // Bilingual lesson — the takeaway for future situations.
  lessonAr      String?
  lessonEn      String?
  // JSON array of tags for fast filtering: ["dairy","expiry","margin"].
  tagsJson      String   @default("[]")
  // JSON array of BrainNode/domain-entity ids this memory references.
  entityRefsJson String  @default("[]")
  // Outcome (the metric that moved + signed delta).
  outcomeMetric String?
  outcomeDelta  Float?
  // Stored vector (JSON array of floats). For SQLite we store as JSON;
  // when migrating to Postgres+pgvector this becomes a real vector(N) column.
  vectorJson    String   @default("[]")
  vectorVersion Int      @default(1)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([occurredAt])
  @@index([module])
}

// =====================================================================
// THE FEEDBACK LOOP — Phase 7 of docs/PHASES-INTELLIGENCE.md
// Every user action on a brain artefact becomes training signal. The
// pattern analyzer turns the feedback log into human-readable rules that
// reweight future brain output.
// =====================================================================

model BrainFeedback {
  id           String   @id @default(cuid())
  ts           DateTime @default(now())
  scope        String   @default("default")
  userId       String?
  // "INSIGHT_DISMISSED" | "INSIGHT_HELPFUL" | "INSIGHT_RESOLVED"
  // | "PLAN_COMMITTED" | "PLAN_ABANDONED" | "PLAN_COMPLETED"
  // | "PLAN_STEP_DONE" | "PLAN_STEP_BLOCKED"
  // | "RECOMMENDATION_OVERRIDDEN" | "OUTCOME_RIGHT" | "OUTCOME_WRONG"
  // | "MEMORY_USEFUL" | "MEMORY_IRRELEVANT"
  kind         String
  // The id of the entity the feedback is about (insight/plan/etc.).
  targetRef    String
  // "insight" | "plan" | "council" | "memory"
  targetType   String?
  module       String?  // domain module the target sits in
  category     String?  // semantic category — "margin_low" | "expiry" | "ramp" | etc.
  signalDelta  Float?   // signed magnitude of the action's signal
  note         String?
  metadataJson String?

  @@index([scope, ts])
  @@index([scope, kind])
  @@index([scope, module, kind])
  @@index([targetType, targetRef])
}

model BrainPattern {
  id              String   @id @default(cuid())
  scope           String   @default("default")
  // Bilingual statement of what the brain learned.
  statementEn     String
  statementAr     String?
  // Machine-actionable rule, JSON. e.g.
  // {"action":"suppress_alert","module":"FINANCE","category":"margin_low","threshold":0.05}
  ruleJson        String   @default("{}")
  // What kinds of feedback events back this pattern.
  kindsJson       String   @default("[]")
  evidenceCount   Int      @default(0)
  confidence      Float    @default(0.5)
  module          String?
  // "ENABLED" | "DISABLED" | "UNLEARNED"
  status          String   @default("ENABLED")
  authoredBy      String   @default("auto") // "auto" | "user"

  firstObservedAt DateTime
  lastObservedAt  DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([scope, status])
  @@index([scope, module])
}

// =====================================================================
// CROSS-ORG FEDERATION — Phase 8 of docs/PHASES-INTELLIGENCE.md
// Privacy-preserving cross-tenant pattern learning. Each org opts in
// explicitly. Only patterns backed by ≥ K peers ever surface, and only
// the aggregate (no per-peer attribution) ever crosses the boundary.
// =====================================================================

model FederationOptIn {
  id            String   @id @default(cuid())
  scope         String   @unique @default("default")
  // "ENABLED" | "DISABLED" | "PENDING_REVIEW"
  status        String   @default("DISABLED")
  agreedToTerms Boolean  @default(false)
  agreedAt      DateTime?
  agreedById    String?
  // JSON array of module names this org consents to share/receive: ["HOTELS","DAIRY",...]
  shareModules  String   @default("[]")
  // Differential-privacy epsilon budget (simplified — counts down from budgetMax).
  budgetUsed    Float    @default(0)
  budgetMax     Float    @default(1.0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FederationPeer {
  id                String   @id @default(cuid())
  // Anonymized peer token — never the real tenant id, never reversible.
  peerToken         String   @unique
  // Tier descriptor used to group peers: "hotels-300-700-mena-midluxury"
  tier              String
  region            String
  size              String
  vertical          String
  // JSON array of pattern keys this peer has contributed.
  contributionsJson String   @default("[]")
  joinedAt          DateTime @default(now())
  lastActiveAt      DateTime @default(now())

  @@index([tier])
  @@index([vertical])
}

model FederationPattern {
  id              String   @id @default(cuid())
  // Stable cluster key so re-aggregation upserts in place.
  clusterKey      String   @unique
  // Bilingual editorial statement of the cross-org learning.
  statementEn     String
  statementAr     String?
  // Tier descriptor (JSON).
  tierJson        String   @default("{}")
  module          String?
  category        String?
  // K-anonymity: peerCount must be >= kAnonymity for the pattern to surface.
  peerCount       Int
  averageDelta    Float
  confidence      Float
  kAnonymity      Int      @default(5)
  noiseEpsilon    Float    @default(0.5)
  // Which org scope can see this benchmark (defaults to all).
  visibleTo       String   @default("default")
  generatedAt     DateTime @default(now())
  expiresAt       DateTime

  @@index([visibleTo, module])
  @@index([expiresAt])
}

// =====================================================================
// THE META BRAIN — Phase 10 of docs/PHASES-INTELLIGENCE.md
// THE CAPSTONE. The brain reads its own performance log weekly, proposes
// adjustments to its own weights, exposes a public IQ score that climbs
// when the brain is improving. The only subsystem that can rewrite the
// brain itself.
// =====================================================================

model BrainIQHistory {
  id              String   @id @default(cuid())
  scope           String   @default("default")
  // Snapshot date — typically end-of-week.
  snappedAt       DateTime
  // The headline number — sales-friendly range of ~70..200.
  iq              Int
  // Components (each in [0,1] before being weighted into IQ).
  accuracy        Float
  decisionVelocity Float
  outcomeQuality  Float
  userTrust       Float
  // What was the dominant input that moved IQ this snapshot?
  drivenBy        String?  // "accuracy" | "velocity" | "outcome" | "trust" | "rebalance"
  note            String?
  createdAt       DateTime @default(now())

  @@index([scope, snappedAt])
}

model BrainWeight {
  id          String   @id @default(cuid())
  scope       String   @default("default")
  // Identifier for the weight target. e.g.
  // "agent:dairy-expert"        | "edge:abc-xyz"
  // "narrator.editorial.tone"   | "memory.expiry.boost"
  target      String
  // Current value (interpretation depends on target).
  value       Float
  // Where the value came from. "default" | "auto-tuned" | "user-override"
  origin      String   @default("default")
  // Bump-only version — increments on every change.
  version     Int      @default(1)
  // Optional human-readable description, used in the diff log.
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, target])
}

model SelfTuningReport {
  id              String   @id @default(cuid())
  scope           String   @default("default")
  ranAt           DateTime @default(now())
  windowDays      Int      @default(7)

  // What the meta brain noticed (JSON array of editorial sentences).
  observationsJson      String   @default("[]")
  // Proposed adjustments (JSON array — each entry: {target, field, from, to, rationale, confidence}).
  proposedAdjustmentsJson String @default("[]")
  // Optional editorial paragraph the meta brain wrote about itself.
  editorialEn     String?
  editorialAr     String?

  iqBefore        Int
  iqAfterIfApplied Int
  iqAfterApplied  Int?

  // "DRAFT" | "APPROVED" | "REJECTED" | "AUTO_APPLIED"
  status          String   @default("DRAFT")
  reviewerNote    String?
  reviewedById    String?
  reviewedAt      DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([scope, ranAt])
  @@index([scope, status])
}

// =====================================================================
// TENANCY — Phase 11 of docs/PHASES-INTELLIGENCE.md
// White-label backbone. Each tenant gets a slug, a theme preset, a set
// of industry packs, and a five-step provisioning trail.
// =====================================================================

model Tenant {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  adminEmail     String
  region         String   @default("MENA")
  tier           String   @default("standard")
  // "PROVISIONING" | "ACTIVE" | "SUSPENDED" | "ARCHIVED"
  status         String   @default("PROVISIONING")
  inviteToken    String?
  seededCount    Int      @default(0)

  steps          TenantStep[]
  theme          TenantTheme?
  packs          TenantPack[]

  createdAt      DateTime @default(now())
  activatedAt    DateTime?
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([region])
}

model TenantStep {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderIndex    Int
  // "subdomain" | "schema" | "seed" | "theme" | "invite"
  key           String
  labelEn       String
  labelAr       String
  // "PENDING" | "RUNNING" | "DONE" | "FAILED"
  status        String   @default("PENDING")
  startedAt     DateTime?
  completedAt   DateTime?
  durationMs    Int?

  @@unique([tenantId, key])
  @@index([tenantId, orderIndex])
}

model TenantTheme {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // "heritage" | "ocean" | "ember" | "forest" | "monolith" | "pearl"
  preset       String   @default("heritage")
  // Custom palette overrides as JSON.
  paletteJson  String   @default("{}")
  emblem       String   @default("◆")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TenantPack {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // "hospitality" | "dairy" | "agri" | "education" | "finance"
  packKey   String
  enabled   Boolean  @default(true)

  @@unique([tenantId, packKey])
  @@index([packKey])
}

// =====================================================================
// WORKFLOW STUDIO — Phase 12 of docs/PHASES-INTELLIGENCE.md
// Visual triggers → conditions → actions. Each tenant can compose any
// number of workflows. Runs are persisted with a node-by-node trace so
// the canvas can replay them on test runs.
// =====================================================================

model Workflow {
  id            String   @id @default(cuid())
  scope         String   @default("default")
  name          String
  description   String?
  enabled       Boolean  @default(false)
  // "DRAFT" | "ACTIVE" | "ARCHIVED"
  status        String   @default("DRAFT")

  nodes         WorkflowNode[]
  edges         WorkflowEdge[]
  runs          WorkflowRun[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastRunAt     DateTime?
  runCount      Int      @default(0)

  @@index([scope, status])
}

model WorkflowNode {
  id           String   @id @default(cuid())
  workflowId   String
  workflow     Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  // "trigger" | "condition" | "action"
  kind         String
  // Identifier of the registered template, e.g. "dairy.expiry_within".
  templateKey  String
  // Optional display override; defaults to template label.
  label        String?
  // JSON params payload — shape defined per template.
  configJson   String   @default("{}")
  // Visual position; auto-laid-out when null.
  posX         Float?
  posY         Float?

  outboundEdges WorkflowEdge[] @relation("EdgeFromNode")
  inboundEdges  WorkflowEdge[] @relation("EdgeToNode")

  createdAt    DateTime @default(now())

  @@index([workflowId])
}

model WorkflowEdge {
  id           String   @id @default(cuid())
  workflowId   String
  workflow     Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  fromNodeId   String
  fromNode     WorkflowNode @relation("EdgeFromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId     String
  toNode       WorkflowNode @relation("EdgeToNode",   fields: [toNodeId],   references: [id], onDelete: Cascade)

  @@unique([workflowId, fromNodeId, toNodeId])
  @@index([workflowId])
}

model WorkflowRun {
  id           String   @id @default(cuid())
  workflowId   String
  workflow     Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  // "RUNNING" | "SUCCESS" | "FAILED" | "DRY_RUN"
  status       String
  // "manual" | "test" | "schedule:<cron>" | "event:<id>"
  triggeredBy  String?
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  durationMs   Int?
  // JSON array of trace events: [{nodeId, kind, status, message, ms}, …]
  traceJson    String   @default("[]")

  @@index([workflowId, startedAt])
}

// =====================================================================
// INTEGRATIONS HUB — Phase 13 of docs/PHASES-INTELLIGENCE.md
// One row per (scope, providerKey). Each integration has scoped
// credentials, settings, and a usage log so we can show "last activity"
// and per-provider failure rates.
// =====================================================================

model Integration {
  id            String   @id @default(cuid())
  scope         String   @default("default")
  // Provider key from the catalog: "slack" | "stripe" | "plaid" | etc.
  providerKey   String
  // "NOT_CONNECTED" | "CONNECTED" | "ERROR" | "EXPIRED"
  status        String   @default("NOT_CONNECTED")
  // JSON array of granted scopes — provider-specific.
  scopesJson    String   @default("[]")
  // Display-only account label, e.g. workspace name or email.
  account       String?
  // Per-provider settings JSON — channels, default sender, etc.
  settingsJson  String   @default("{}")

  credential    IntegrationCredential?
  logs          IntegrationLog[]

  connectedAt   DateTime?
  lastUsedAt    DateTime?
  errorCount    Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([scope, providerKey])
  @@index([scope, status])
}

model IntegrationCredential {
  id            String   @id @default(cuid())
  integrationId String   @unique
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  // Encrypted token blob. In dev this is a placeholder string.
  tokenBlob     String
  expiresAt     DateTime?
  rotatedAt     DateTime @default(now())
}

model IntegrationLog {
  id            String   @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  // "connect" | "disconnect" | "send" | "receive" | "error"
  kind          String
  // 1-line operator-readable summary.
  message       String
  // Optional payload digest (never the full payload).
  payloadDigest String?
  // ms duration of the call (when applicable).
  ms            Int?
  ts            DateTime @default(now())

  @@index([integrationId, ts])
}

// =====================================================================
// DOCUMENT INTELLIGENCE — Phase 18 of docs/PHASES-INTELLIGENCE.md
// One row per uploaded document. Each parse produces a single
// DocExtraction with the structured fields we recovered, plus zero or
// more DocClause rows for risk clauses we want to surface in the UI.
// =====================================================================

model Document {
  id           String   @id @default(cuid())
  scope        String   @default("default")
  // "contract" | "invoice" | "lab_report" | "spreadsheet" | "other"
  kind         String   @default("other")
  // Original filename as uploaded.
  fileName     String
  fileSize     Int      @default(0)
  mimeType     String?
  // Free-text title we surfaced (from the file or extraction).
  title        String?
  titleEn      String?
  // The narrator's one-paragraph summary.
  summary      String?
  summaryEn    String?
  // "PARSING" | "READY" | "FAILED" — pass-through status the UI shows.
  status       String   @default("PARSING")
  // What module / company this got linked to ("LORAN", "MAHA", "ARENA", etc).
  linkedTo     String?
  // ms it took to parse — informational only.
  parsedMs     Int?
  uploadedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  extraction   DocExtraction?
  clauses      DocClause[]

  @@index([scope, status])
  @@index([scope, kind])
  @@index([createdAt])
}

model DocExtraction {
  id          String   @id @default(cuid())
  documentId  String   @unique
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // Structured fields — JSON dictionary keyed by extraction kind.
  // For a contract: { parties: [...], effectiveDate, termMonths, totalValue, ... }
  // For an invoice: { vendor, invoiceNumber, dueDate, total, currency, ... }
  // We keep it as JSON for pluggability — industry packs add their own keys.
  fieldsJson  String   @default("{}")
  // The raw narrator-style headline ("14-page supplier agreement, 3-year term").
  headline    String?
  headlineEn  String?
  createdAt   DateTime @default(now())
}

model DocClause {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // "risk" | "obligation" | "termination" | "renewal" | "indemnity" | "data" | "info"
  kind        String   @default("info")
  // The actual quote, verbatim from the doc (truncated to ~280 chars).
  quote       String
  quoteEn     String?
  // What page / section we found it in.
  page        Int?
  // Severity for the UI — "low" | "medium" | "high"
  severity    String   @default("low")
  // Editorial gloss the narrator wrote about it.
  note        String?
  noteEn      String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([documentId, orderIndex])
}

// =====================================================================
// IMPORT LOG — one row per external-import POST (POST
// /api/import/test). Bearer-authenticated ingestion endpoint; this is
// the audit trail of what came in, how much was accepted/rejected and
// why. No companyId → not workspace-scoped (system-level).
// SQLite has no JSON type, so `errors` is a JSON string.
// =====================================================================
model ImportLog {
  id        String   @id @default(cuid())
  // Which import endpoint produced this row ("test" for now).
  endpoint  String   @default("test")
  // Optional caller-supplied label (body.source) — who/what sent it.
  source    String?
  // Caller-supplied tenant label from the POST body. NOT a Tenant FK —
  // it is an opaque, caller-controlled string (length-capped on write,
  // never auto-creates a Tenant row).
  tenantId  String?
  accepted  Int      @default(0)
  rejected  Int      @default(0)
  // JSON-stringified Array<{ index: number; error: string }>.
  errors    String?
  // "OK" | "PARTIAL" | "REJECTED"
  status    String   @default("OK")
  // Best-effort requester IP for the audit trail.
  ip        String?
  createdAt DateTime @default(now())

  // One row per record in the batch (structured + raw).
  rows      ImportRow[]

  @@index([createdAt])
  @@index([endpoint])
  @@index([tenantId])
}

// =====================================================================
// IMPORT ROW — one row per record inside an ImportLog batch. The
// endpoint lifts known fields into structured columns so /admin/imports
// can query them, and keeps the verbatim record in `rowData` for
// debugging. Cascade-deleted with its parent batch.
// =====================================================================
model ImportRow {
  id          String    @id @default(cuid())
  importLogId String
  importLog   ImportLog @relation(fields: [importLogId], references: [id], onDelete: Cascade)
  // Structured columns lifted from the record.
  sku         String?
  productName String?
  quantity    Int?
  // Money. Intended precision/scale = (12,2). The native @db.Decimal
  // attribute is NOT supported on the sqlite provider, so it is omitted
  // here and applied on the Postgres cutover (W9). Prisma's Decimal
  // scalar still gives exact decimal handling on SQLite.
  unitCost    Decimal?
  supplier    String?
  warehouse   String?
  // Verbatim record JSON, kept for debugging (SQLite has no JSON type).
  rowData     String    @default("{}")
  // "ACCEPTED" | "REJECTED"
  status      String    @default("ACCEPTED")
  // Rejection reason when status = "REJECTED".
  error       String?
  // Live-product linkage. Null for rejected rows and pre-Phase-3 rows.
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([importLogId])
  @@index([sku])
  @@index([productId])
}

// =====================================================================
// PRODUCT — operational source of truth. The import endpoint upserts
// into this by (tenantId, sku); ImportLog/ImportRow remain the audit
// trail. tenantId is an OPAQUE caller-supplied label (matches
// ImportLog.tenantId + docs/IMPORT-PIPELINE.md) — deliberately NOT a
// Tenant FK: Tenant.id is a cuid, the table is empty (single-tenant by
// default), and the n8n payload sends "hourani-hotels". A hard FK would
// P2003 every import. Composite-unique + indexed gives dedup and
// tenant-scoped queries without the harmful constraint.
// =====================================================================
model Product {
  id              String    @id @default(cuid())
  tenantId        String
  sku             String
  name            String
  quantity        Int       @default(0)
  // Money. Intended precision/scale = (12,2); the native @db.Decimal
  // attribute is unsupported on the sqlite provider (same as
  // ImportRow.unitCost) — applied on the W9 Postgres cutover.
  unitCost        Decimal?
  supplier        String?            // legacy — dropped in Schema-2 (Phase 7)
  supplierId      String?
  warehouse       String?

  // Provenance / audit linkage.
  firstImportedAt DateTime  @default(now())
  lastImportedAt  DateTime  @default(now())
  // Spec's "importHistory count" — # of imports that touched this row.
  importCount     Int       @default(1)

  // Soft-delete column only. Wiring into lib/softDelete.ts is deferred
  // (no delete UI this phase, per the task).
  deletedAt       DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  importRows      ImportRow[]
  movements       InventoryMovement[]
  poLines         PurchaseOrderLine[]
  soLines         SalesOrderLine[]
  supplierRef     Supplier? @relation(fields: [supplierId], references: [id])

  @@unique([tenantId, sku])
  @@index([tenantId, deletedAt])
  @@index([tenantId, supplier])
  @@index([tenantId, supplierId])
  @@index([tenantId, warehouse])
}

// =====================================================================
// INVENTORY MOVEMENT — append-only stock ledger (Phase 5). Every stock
// change is one immutable row; Product.quantity becomes a denormalized
// cache = SUM(delta) WHERE productId AND deletedAt IS NULL. Mistakes are
// corrected by a compensating reverse movement, never an edit/delete
// (decision #1). tenantId is the same OPAQUE caller label as Product /
// ImportLog — no Tenant FK. sourceImportLogId/documentRef are opaque
// text for now (documentRef → FK in Phase 6, same precedent).
// Movement type is a string enum per the CLAUDE.md SQLite rule.
// =====================================================================
model InventoryMovement {
  id                String   @id @default(cuid())
  tenantId          String
  productId         String
  // IMPORT | RECEIVED | SOLD | TRANSFER_OUT | TRANSFER_IN | ADJUSTMENT
  // | DAMAGED | RETURN_FROM_CUSTOMER | RETURN_TO_SUPPLIER
  type              String
  // Signed: positive = stock in, negative = stock out.
  delta             Int
  reason            String
  occurredAt        DateTime @default(now())

  // Provenance.
  sourceImportLogId String?
  note              String?
  userId            String?
  documentRef       String?

  // Append-only (decision #1): no edit/delete UI. deletedAt exists for
  // exceptional admin correction only; recalc excludes soft-deleted rows.
  deletedAt         DateTime?
  createdAt         DateTime @default(now())

  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId, occurredAt])
  @@index([tenantId, type, occurredAt])
  @@index([productId, deletedAt])
}

// =====================================================================
// TENANT IMPORT MAPPING — per (tenantId, sourceSystem) field-name
// translation, applied by the import endpoint BEFORE Zod (Phase 4).
// Opt-in: no row, or active=false → payload passes through unchanged.
// tenantId is an OPAQUE label, no Tenant FK (same precedent as Phase 3
// Product). JSON is stored as String — codebase-wide convention
// (SQLite has no JSON type; cf. ImportRow.rowData, *Json columns).
// =====================================================================
model TenantImportMapping {
  id           String   @id @default(cuid())
  tenantId     String
  // Short identifier the tenant picks, e.g. "maha-erp". Matched against
  // the batch `source` by prefix at import time.
  sourceSystem String
  // Human label: "Maha Dairy stock export".
  description  String?

  // JSON object string { "their_field": "our_field" }, e.g.
  // {"Item Code":"sku","Stock Level":"quantity","السعر":"unitCost"}.
  fieldMapJson String   @default("{}")
  // Optional JSON object string of fallback values for missing fields,
  // e.g. {"warehouse":"Amman-A"}. Null/absent → no defaults.
  defaultsJson String?

  // Disabled mappings are ignored (payload passes through as-is).
  active       Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, sourceSystem])
  @@index([tenantId, active])
}

// =====================================================================
// PURCHASE ORDERS — procurement (Phase 6). DRAFT → SENT → PARTIAL →
// RECEIVED → CANCELLED. Only RECEIVED/PARTIAL receipts write RECEIVED
// inventory movements (via lib/inventory.ts). supplier is an OPAQUE
// string (becomes an FK in Phase 7, same precedent as Product.tenantId).
// deletedAt column only — not registered in lib/softDelete.ts (no trash
// UI), consistent with Product / InventoryMovement.
// =====================================================================
model PurchaseOrder {
  id          String   @id @default(cuid())
  tenantId    String
  poNumber    String   @unique
  supplier    String   // legacy NOT NULL — dual-written until Schema-2 drop
  supplierId  String?
  // DRAFT | SENT | PARTIAL | RECEIVED | CANCELLED
  status      String   @default("DRAFT")
  orderedAt   DateTime @default(now())
  expectedAt  DateTime?
  note        String?

  lines       PurchaseOrderLine[]
  supplierRef Supplier? @relation(fields: [supplierId], references: [id])

  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, supplier])
  @@index([tenantId, supplierId])
  @@index([tenantId, orderedAt])
}

model PurchaseOrderLine {
  id          String   @id @default(cuid())
  poId        String
  productId   String
  quantity    Int      // ordered
  receivedQty Int      @default(0)
  // Money. Bare Decimal? — @db.Decimal unsupported on sqlite (same
  // precedent as Product.unitCost / ImportRow.unitCost; W9 cutover).
  unitCost    Decimal?

  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id])

  @@index([poId])
  @@index([productId])
}

// =====================================================================
// SALES ORDERS — fulfillment (Phase 6). DRAFT → CONFIRMED → PARTIAL →
// FULFILLED → CANCELLED. Only FULFILLED/PARTIAL fulfillment writes SOLD
// movements (negative delta). Stock availability is checked at create
// and again at CONFIRMED. customer is an OPAQUE string (FK in Phase 7).
// =====================================================================
model SalesOrder {
  id          String   @id @default(cuid())
  tenantId    String
  soNumber    String   @unique
  customer    String   // legacy NOT NULL — dual-written until Schema-2 drop
  customerId  String?
  // DRAFT | CONFIRMED | PARTIAL | FULFILLED | CANCELLED
  status      String   @default("DRAFT")
  orderedAt   DateTime @default(now())
  requiredBy  DateTime?
  note        String?

  lines       SalesOrderLine[]
  customerRef Customer? @relation(fields: [customerId], references: [id])

  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, customer])
  @@index([tenantId, customerId])
  @@index([tenantId, orderedAt])
}

model SalesOrderLine {
  id            String   @id @default(cuid())
  soId          String
  productId     String
  quantity      Int      // ordered
  fulfilledQty  Int      @default(0)
  // Money. Bare Decimal? (same precedent as above).
  unitPrice     Decimal?

  so            SalesOrder @relation(fields: [soId], references: [id], onDelete: Cascade)
  product       Product    @relation(fields: [productId], references: [id])

  @@index([soId])
  @@index([productId])
}

// =====================================================================
// SUPPLIER / CUSTOMER — real entities (Phase 7). Promotes the opaque
// supplier/customer strings on Product/PurchaseOrder/SalesOrder to
// tenant-scoped FK tables. Forward relation fields are supplierRef /
// customerRef (the scalar names supplier/customer stay as legacy
// columns until the Schema-2 drop, so the relation can't reuse them).
// paymentTerms is a plain string (Phase 8 formalizes). Soft-delete via
// deletedAt; not registered in lib/softDelete.ts (no trash UI),
// consistent with Product / InventoryMovement / PO / SO.
// =====================================================================
model Supplier {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  email         String?
  phone         String?
  address       String?
  paymentTerms  String?  // "Net 30" | "COD" | "Prepaid" — plain string
  notes         String?

  products       Product[]
  purchaseOrders PurchaseOrder[]

  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, deletedAt])
}

model Customer {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  email         String?
  phone         String?
  address       String?
  paymentTerms  String?
  notes         String?

  salesOrders   SalesOrder[]

  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, deletedAt])
}


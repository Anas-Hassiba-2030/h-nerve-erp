# H-Nerve — environment template. Copy to `.env` and fill real values.
# `.env` is gitignored; THIS file (no secrets) is safe to commit.

# --- Database ---
# Pitch / dev: SQLite (default, no setup).
DATABASE_URL="file:./dev.db"
# Phase B (production): a Postgres URL from Neon/Supabase/RDS, e.g.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hnerve?sslmode=require"

# --- Auth ---
# 32+ char random string. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_PASSWORD="replace-with-a-strong-32+-char-random-secret"

# --- AI (the Brain) ---
# From console.anthropic.com. Without it the Brain runs in canned stub mode.
ANTHROPIC_API_KEY="sk-ant-..."
# Optional model override.
# ANTHROPIC_MODEL="claude-sonnet-4-5"

# --- Spoken voice (Talk to the Brain) ---
# FREE by default — no key needed. A real, natural female voice (AWS Polly via
# StreamElements) is used out of the box. Pick the one you like:
#   Joanna (default), Kimberly, Salli, Kendra, Amy, Emma, Nicole; Arabic: Zeina
# TTS_VOICE="Joanna"
#
# OPTIONAL premium upgrade — studio-grade / custom voices from elevenlabs.io.
# When set, it takes over automatically; otherwise the free voice is used.
# ELEVENLABS_API_KEY="..."
# ELEVENLABS_VOICE_ID="EXAVITQu4vr4xnSDxMaL"
# ELEVENLABS_MODEL_ID="eleven_multilingual_v2"

# --- Document Intelligence (Phase 18 / W10) ---
# The stub is the live path by default — ZERO API credit is spent on
# uploads. Set this to "true" to extract real images/PDFs with Claude
# Vision (needs ANTHROPIC_API_KEY above). This BURNS API credit.
# DOCINTEL_USE_VISION="false"
# Per-process spend cap for Vision calls (default 50). Past it → stub.
# DOCINTEL_MAX_VISION_CALLS="50"

# --- Import API ---
# Bearer token for POST /api/import/test. Unset → the endpoint
# returns 503. Generate:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
IMPORT_API_TOKEN=""

# --- Seed ---
# Strong admin password for the pilot. Omit in pitch/dev (falls back to admin123).
SEED_ADMIN_PASSWORD=""

# --- Demo ---
# "1" hides the onboarding tour + welcome splash (use on the pitch laptop).
# Empty in production so real first-time users get the intro.
NEXT_PUBLIC_DISABLE_INTRO=""

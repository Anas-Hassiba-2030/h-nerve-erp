# H-Nerve — environment template. Copy to `.env` and fill real values.
# `.env` is gitignored; THIS file (no secrets) is safe to commit.

# --- Database ---
# Pitch / dev: SQLite (default, no setup).
DATABASE_URL="file:./dev.db"
# Phase B (production): a Postgres URL from Neon/Supabase/RDS, e.g.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/hnerve?sslmode=require"

# --- Neon (Phase 4 §2 — Cloudflare migration) ---
# When set, the app connects through the Neon serverless driver adapter
# (WebSocket) instead of direct TCP. Leave BOTH unset on Railway.
# Pooled URL (note the -pooler host) — used by the app at runtime:
# NEON_DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require"
# Direct URL (no -pooler) — used ONLY by `prisma migrate deploy` + drift checks
# at cutover, never by app code:
# NEON_DIRECT_URL="postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/db?sslmode=require"

# --- Auth ---
# 32+ char random string. Generate:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_PASSWORD="replace-with-a-strong-32+-char-random-secret"

# --- AI (the Brain) ---
#
# Every model call goes through gw-front (Anthropic Messages API, Anthropic
# models only: claude-haiku-5-5 / claude-sonnet-5-5 / claude-opus-5-5). There is
# no provider key and no direct provider endpoint. Without GW_API_KEY the Brain
# runs in canned stub mode (the UI works; the analysis is not real).
# The gateway is TEXT-ONLY: no images in or out.
#
# Credential for gw-front. Local dev: put it in .env. Worker: `wrangler secret put GW_API_KEY`.
GW_API_KEY=""
# Gateway base URL (default shown; only set to point at another gw-front).
# GW_BASE_URL="https://gw-front.anashasiba91.workers.dev"
# Default model (default claude-sonnet-5-5). Council + planner default to claude-haiku-5-5.
# GW_MODEL="claude-sonnet-5-5"
# BRAIN_COUNCIL_MODEL="claude-haiku-5-5"
# BRAIN_PLANNER_MODEL="claude-haiku-5-5"
# Total deadline per call in ms (floor 15000, default 30000; first token takes ~3 s).
# BRAIN_LLM_TIMEOUT_MS="30000"
# On the Worker, a same-account workers.dev fetch to gw-front fails: add a service
# binding named SVC_GWFRONT to wrangler.jsonc (service: "gw-front"); the client uses
# it automatically and falls back to plain fetch.
# Per-process lifetime cap on real gateway calls (default 200). Past it → stub.
# BRAIN_MAX_LLM_CALLS="200"
# Per-TENANT daily cap on LLM-bound converse requests (default 300; 0 disables).
# On breach that tenant's /api/converse answers degrade to stub until midnight UTC.
# BRAIN_TENANT_DAILY_LLM_CALLS="300"

# --- Spoken voice (Talk to the Brain) ---
# FREE by default — no key needed. A real, soft female voice (AWS Polly via
# StreamElements) is used out of the box. Pick the one you like:
#   Salli (default, soft/cute), Kimberly (breathy), Joanna (warm), Amy/Emma
#   (British), Nicole (Australian); Arabic: Zeina
# TTS_VOICE="Salli"
#
# OPTIONAL premium upgrade — studio-grade / custom voices from elevenlabs.io.
# When set, it takes over automatically; otherwise the free voice is used.
# ELEVENLABS_API_KEY="..."
# ELEVENLABS_VOICE_ID="EXAVITQu4vr4xnSDxMaL"
# ELEVENLABS_MODEL_ID="eleven_multilingual_v2"

# --- Embeddings (RAG) ---
# No key, no provider. A Node server runs a LOCAL model in-process
# (@huggingface/transformers, Xenova/paraphrase-multilingual-MiniLM-L12-v2,
# 384 dims, downloaded once into the HF cache). Cloudflare Workers cannot run it
# and use the deterministic hash embedder (256 dims) instead.
# EMBED_BACKEND="transformers"   # or "hash" to force the offline hash embedder
# EMBED_MODEL="Xenova/paraphrase-multilingual-MiniLM-L12-v2"
# After switching backends re-embed stored memories:
#   npx tsx --tsconfig tsconfig.scripts.json scripts/reindex-embeddings.ts --apply

# --- Document Intelligence (Phase 18) ---
# The stub is the live path by default — ZERO gateway budget is spent on
# uploads. Set this to "true" to extract TEXT-like uploads (txt/csv/json/md) with
# Claude through gw-front (needs GW_API_KEY). Images and PDFs are NOT sent: the
# gateway is text-only, so they need an OCR step first and stay on the stub.
# DOCINTEL_USE_LLM="false"
# Per-process cap for document-parse calls (default 50). Past it → stub.
# DOCINTEL_MAX_LLM_CALLS="50"

# --- Import API ---
# Bearer token for POST /api/import/test. Unset → the endpoint
# returns 503. Generate:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
IMPORT_API_TOKEN=""

# --- Seed ---
# Strong admin password for the pilot. Omit in pitch/dev (falls back to admin123).
SEED_ADMIN_PASSWORD=""

# --- Demo ---
# "1" hides the onboarding tour + welcome splash (use on the pitch laptop).
# Empty in production so real first-time users get the intro.
NEXT_PUBLIC_DISABLE_INTRO=""
